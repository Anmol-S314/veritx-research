{
  "$id": "https://veritx.dev/contracts/srota/v1/topology.view",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TopologyView",
  "description": "Materialized fabric graph: routers with attachment seats, directed channels and agent endpoints. The topology family string in DesignView is intent metadata; this view is the certified artifact the certificate proved, and it is the only graph Studio may draw.",
  "type": "object",
  "required": ["contract_version", "revision_id", "design_hash", "topology_hash", "attachment_hash", "family", "routers", "channels", "physical_links", "endpoints", "counts"],
  "properties": {
    "contract_version": {"const": 1},
    "revision_id": {"type": ["string", "null"]},
    "design_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "topology_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attachment_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "family": {"enum": ["mesh", "torus", "ring", "concentrated_mesh"]},
    "routers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["router_id", "coordinates", "seat_capacity"],
        "properties": {
          "router_id": {"type": "integer", "minimum": 0},
          "coordinates": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "seat_capacity": {"type": "integer", "minimum": 1}
        },
        "unevaluatedProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel_id", "src_router", "src_port", "dst_router", "dst_port", "width_bits", "latency_cycles"],
        "properties": {
          "channel_id": {"type": "integer", "minimum": 0},
          "src_router": {"type": "integer", "minimum": 0},
          "src_port": {"type": "integer", "minimum": 0},
          "dst_router": {"type": "integer", "minimum": 0},
          "dst_port": {"type": "integer", "minimum": 0},
          "width_bits": {"type": "integer", "minimum": 1},
          "latency_cycles": {"type": "integer", "minimum": 0},
          "route_weight": {"type": "integer", "minimum": 1},
          "physical_link_id": {"type": ["integer", "null"], "minimum": 0}
        },
        "unevaluatedProperties": false
      }
    },
    "physical_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["physical_link_id", "channel_ids"],
        "properties": {
          "physical_link_id": {"type": "integer", "minimum": 0},
          "channel_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "length_mm": {"type": ["number", "null"], "minimum": 0}
        },
        "unevaluatedProperties": false
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint_id", "kind", "group_index", "instance_index", "router_id", "port_id"],
        "properties": {
          "endpoint_id": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["compute_tile", "hbm_controller", "nic", "peripheral", "ucie_port"]},
          "group_index": {"type": "integer", "minimum": 0},
          "instance_index": {"type": "integer", "minimum": 0},
          "router_id": {"type": "integer", "minimum": 0},
          "port_id": {"type": "integer", "minimum": 0}
        },
        "unevaluatedProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["routers", "channels", "seats", "endpoints"],
      "properties": {
        "routers": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 0},
        "seats": {"type": "integer", "minimum": 1},
        "endpoints": {"type": "integer", "minimum": 1}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
