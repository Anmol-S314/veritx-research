{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritx.dev/contracts/loom/v1/catalog.schema.json",
  "title": "Loom local IP catalog v1",
  "description": "Offline editable interface templates; not evidence of vendor IP behavior or qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "version", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "vendor", "family", "version", "class", "tags", "clocks", "resets", "powers", "ports", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "vendor": { "type": ["string", "null"] }, "family": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "class": { "enum": ["router", "compute", "memory", "bridge", "peripheral"] },
        "tags": { "$ref": "#/$defs/strings" }, "clocks": { "$ref": "#/$defs/strings" }, "resets": { "$ref": "#/$defs/strings" }, "powers": { "$ref": "#/$defs/strings" },
        "description": { "type": "string", "minLength": 1 },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } }
      }
    },
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "protocol", "dataWidth", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "role": { "enum": ["initiator", "target", "bidirectional"] },
        "protocol": { "type": "string", "minLength": 1 }, "dataWidth": { "type": "integer", "minimum": 1 },
        "addressWidth": { "type": "integer", "minimum": 1, "maximum": 64 }, "capabilities": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
