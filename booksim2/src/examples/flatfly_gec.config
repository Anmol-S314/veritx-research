// GEC config: express / flattened-butterfly corner (mesh=0, d=1, o=k-1).
// Every router connects directly (1 hop) to every other router in its
// row and its column -- diameter 2, port count c+2*(k-1). Verified
// throughput/latency-identical to BookSim's native `flatfly` topology
// across injection rates 0.05-0.90 at matched num_vcs/vc_buf_size/timing
// (see src/sweep_gec_vs_flatfly.sh).
//
// 16 routers (k=4), c=1 -> 16 terminals.

topology = gec;
routing_function = dor;

k = 4;
c = 1;
o = 3;     // o = k-1 required when d=1 (full point-to-point row/column)
d = 1;
mesh = 0;

// Flow control
num_vcs     = 8;
vc_buf_size = 8;
wait_for_tail_credit = 0;

// Router architecture
vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

routing_delay     = 1;
vc_alloc_delay    = 1;
sw_alloc_delay    = 1;
credit_delay      = 1;
st_prepare_delay  = 0;
st_final_delay    = 1;

input_speedup     = 1;
output_speedup    = 1;
internal_speedup  = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 128;

// GEC hardcodes 1-cycle channel latency (no wire-length model) --
// use_noc_latency must be explicitly 0 or GEC refuses to build.
use_noc_latency = 0;

// Traffic
traffic         = uniform;
packet_size     = 5;
injection_rate  = 0.10;   // saturates around ~0.18-0.19 at this size; raise to explore

// Simulation
sim_type       = latency;
warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;
