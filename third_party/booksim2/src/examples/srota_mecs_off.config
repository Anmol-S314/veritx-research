// ----------------------------------------------------------------------
//  MECS-off ablation baseline -- TOPO-003 section 5.
//
//  "Off reverts to a plain concentrated mesh -- the ablation baseline."
//  This is the configuration the express layer's gains are measured
//  against: same routers, same concentration, same routing, nearest-
//  neighbour links instead of express channels.
//
//  Section 4.4 requires island_count = 0 here, and the model enforces
//  it: without express reach a route to an island column would traverse
//  arbitrary routers, every one of which would need to be QoS-aware.
//
//  Compare against srota_reference.config for the reach claim (up to 30
//  hops here versus <=2 with express) and against a matched express run
//  for the latency and throughput deltas.
// ----------------------------------------------------------------------

topology = srota;
routing_function = o1turn;

k = 16;
c = 4;

srota_mecs           = 0;   // TOPO_MECS_ENABLE = 0: plain concentrated mesh
srota_island_col_map = 0;   // mandatory when MECS is off (section 4.4)
srota_path_en        = 3;   // Valiant on a mesh is a very long detour
srota_vc_policy      = rank;
srota_cdg_radix      = 4;

num_vcs     = 4;
vc_buf_size = 8;
wait_for_tail_credit = 0;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

routing_delay    = 1;
vc_alloc_delay   = 1;
sw_alloc_delay   = 1;
credit_delay     = 1;
st_prepare_delay = 0;
st_final_delay   = 1;

input_speedup    = 1;
output_speedup   = 1;
internal_speedup = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 512;
use_noc_latency = 0;

traffic        = uniform;
packet_size    = 5;
injection_rate = 0.01;

sim_type       = latency;
warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;
