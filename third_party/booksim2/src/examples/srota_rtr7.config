// ----------------------------------------------------------------------
//  RT-R7 -- the path-shape mixing hazard, ROUTE-001 rev 0.3 section 4.5.
//
//  Section 4.5.4: "Run the section 4.4 model check on the 4x4
//  abstraction with ROUTE_PATH_EN = 0b111. It is a two-node cycle
//  needing only two flows; if the hazard is real the check finds it
//  immediately."
//
//  This config IS that run. Elaboration builds the channel dependency
//  graph the routing rules admit and reports whether it has a cycle,
//  before a single flit moves.
//
//  Change srota_vc_policy to compare the candidate resolutions from
//  section 4.5.3 on identical traffic:
//
//    none      no separation -- the unmitigated hazard (expect a CYCLE)
//    oneshape  section 4.5.3 option 1, one shape per epoch, 0 extra VCs
//    shape     section 4.5.3 option 2, O1TURN's own two VC sets
//    rank      hop-rank split; not in section 4.5.3's option table
//
//  With srota_path_en = 3 (both direct shapes, no Valiant) all four
//  policies are legal, so this is the apples-to-apples comparison.
// ----------------------------------------------------------------------

topology = srota;
routing_function = o1turn;

k = 4;                      // section 4.4's abstraction radix
c = 1;

srota_mecs        = 3;
srota_path_en     = 3;      // row-first + column-first, the mixing case
srota_vc_policy   = none;   // <-- the experiment axis
srota_cong_thresh = 4;      // low, so both shapes actually get selected
srota_epoch_len   = 256;
srota_cdg_radix   = 4;      // section 4.4's 4x4 model check

num_vcs     = 1;            // Plane D has no VC arrays (VC-002 2.1)
vc_buf_size = 4;
wait_for_tail_credit = 0;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

routing_delay    = 1;
vc_alloc_delay   = 1;
sw_alloc_delay   = 1;
credit_delay     = 1;
st_prepare_delay = 0;
st_final_delay   = 1;

input_speedup    = 1;
output_speedup   = 1;
internal_speedup = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 512;
use_noc_latency = 0;

traffic        = uniform;
packet_size    = 4;
injection_rate = 0.05;

sim_type       = latency;
warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;
