// GEC config: hybrid mesh+MECS -- every router keeps its nearest-
// neighbor mesh links AND o MECS express channels per dimension on top.
// hybrid_gec routing re-evaluates at every hop, while a dimension is
// still unresolved, whether to take a mesh step or the MECS jump, using
// a real UGAL cost = queue_occupancy * hop_count comparison (mesh's H =
// remaining grid distance, MECS's H = 1, since an express jump always
// reaches the target row/column-mate directly).
//
// k=4, c=1 -> 16 terminals, matching traffic_matrix.txt's 16x16 shape.
// o=1, d=3: one MECS channel per dimension per router, shared by all 3
// row/column peers (the same sharing degree already validated in
// mecs_gec.config).

topology = gec;
routing_function = hybrid;

k = 4;
c = 1;
o = 1;
d = 3;
mesh = 0;
hybrid = 1;

// Flow control -- num_vcs must be >= 2*d (hybrid_gec's phase split needs
// 2 phases x d taps worth of disjoint VC sub-ranges).
num_vcs     = 8;
vc_buf_size = 8;
wait_for_tail_credit = 0;

// Router architecture
vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

// routing_delay must stay > 0: same lookahead/GetSink() ambiguity reason
// as plain MECS (d>1 here too).
routing_delay     = 1;
vc_alloc_delay    = 1;
sw_alloc_delay    = 1;
credit_delay      = 1;
st_prepare_delay  = 0;
st_final_delay    = 1;

input_speedup     = 1;
output_speedup    = 1;
internal_speedup  = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 128;

// GEC hardcodes 1-cycle channel latency (no wire-length model) --
// use_noc_latency must be explicitly 0 or GEC refuses to build.
use_noc_latency = 0;

// Traffic -- the actual traffic_matrix.txt, as requested for this dry run.
traffic         = uniform;
packet_size     = 5;
injection_rate  = 0.5;   // known-stable region for this matrix at this size (see routing_comparison_report.txt)

sim_type       = latency;
warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;
