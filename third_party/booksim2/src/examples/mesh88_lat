// 4x4 Mesh — 16 nodes
// Same traffic matrix and injection rate as MECS experiment

// Topology
topology = mesh;
k = 8;
n = 2;

// Routing
routing_function = dor;

// Flow control
num_vcs     = 4;
vc_buf_size = 15;
wait_for_tail_credit = 0;

// Router architecture
vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

// Delays
routing_delay  = 1;
vc_alloc_delay = 1;
sw_alloc_delay = 1;
credit_delay   = 1;

st_prepare_delay = 0;
st_final_delay   = 1;

// Speedups
input_speedup    = 1;
output_speedup   = 1;
internal_speedup = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 128;

use_noc_latency = 0;

// Traffic
//traffic = matrix(../traffic_matrix.txt);
packet_size = 5;
injection_rate = 0.2;

// Simulation
//sim_type = latency;

warmup_periods = 3;
sample_period = 10000;
sim_count = 1;

sim_type = trace;
trace_file = src/examples/workload64_trace.csv;
trace_packet_log = src/examples/mesh88_packets_out.csv;
