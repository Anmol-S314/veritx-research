// Srota under trace replay — the bring-up configuration.
//
// Same fabric as tracks/t3-topology/configs/srota16.cfg (k=4, c=1, 16
// terminals), driven by TraceTrafficManager instead of a statistical
// injector. See tracks/t3-topology/docs/SROTA-NEXT-STEPS.md for why the
// trace path is the one the unimplemented features are measured on.
//
//   python3 tracks/t3-topology/scripts/gen_trace.py \
//       src/examples/workload16.yaml src/examples/workload16_trace.csv
//   make tool-run TOOL=booksim2 ARGS="src/examples/srota_trace.config"
//
// Or through the trust gate, which is how a number from this config
// becomes quotable:
//
//   python3 tracks/t3-topology/scripts/srota_trust_check.py \
//       --config third_party/booksim2/src/examples/srota_trace.config \
//       --trace  third_party/booksim2/src/examples/workload16_trace.csv

topology = srota;
routing_function = o1turn;

k = 4;              // 4x4 concentrator routers
c = 1;              // 1 tile per router -> 16 terminals

srota_mecs        = 3;      // row + column express
srota_path_en     = 3;      // row-first + column-first, no Valiant
srota_vc_policy   = rank;   // deadlock-free with both shapes live
srota_cong_thresh = 8;
srota_epoch_len   = 1024;
srota_cdg_radix   = 4;      // F1 check runs at elaboration, every run

num_vcs = 4;
vc_buf_size = 8;

// REQUIRED by the Srota model: it prices express channels at
// srota_drop_latency and mesh links at 1, and refuses use_noc_latency=1
// rather than returning a mis-priced number.
use_noc_latency = 0;

// REQUIRED: MECS taps defeat BookSim's lookahead routing, so route
// compute must not be folded into the previous hop.
routing_delay = 1;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

vc_alloc_delay = 1;
sw_alloc_delay = 1;
credit_delay   = 1;

st_prepare_delay = 0;
st_final_delay   = 1;

wait_for_tail_credit = 0;
hold_switch_for_packet = 0;
buffer_policy = private;

// packet_size is the fallback only; the trace carries a size per packet.
packet_size = 5;

sim_type = trace;
trace_file       = src/examples/workload16_trace.csv;
trace_packet_log = src/examples/srota_packets_out.csv;

sample_period = 10000;
sim_count = 1;
