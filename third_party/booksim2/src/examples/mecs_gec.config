topology = gec;
routing_function = dor;

k = 4;
c = 4;
o = 1;
d = 3;     // d = k-1: pure MECS at k=4
mesh = 0;

num_vcs     = 6;   // must be >= d; 6 gives 2 VCs/tap cleanly (4 left 1 VC unused: 4/3 floors to 1)
vc_buf_size = 32;
wait_for_tail_credit = 0;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

routing_delay     = 1;   // must stay >0 for MECS (d>1)
vc_alloc_delay    = 1;
sw_alloc_delay    = 1;
credit_delay      = 1;
st_prepare_delay  = 0;
st_final_delay    = 1;

input_speedup     = 1;
output_speedup    = 1;
internal_speedup  = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 128;

use_noc_latency = 0;

//traffic         = uniform;

sim_type = trace;
trace_file = src/examples/workload64_trace.csv;
trace_packet_log = src/examples/mecs_gec_packets_out.csv;

packet_size     = 5;
injection_rate  = 0.15;  // last stable rate for this exact config: 0.15 -> lat=39.4, 0.20 -> lat=425 (already saturating), 0.25 -> unstable


warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;