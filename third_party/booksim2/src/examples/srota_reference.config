// ----------------------------------------------------------------------
//  Srota NoC -- reference configuration.
//
//  TOPO-003 section 2.1's reference fabric: 1,024 tiles as a 16x16
//  concentrated mesh at c=4, MECS express on both dimensions, and the
//  two QoS island columns of section 4.3 (one HBM-facing, one
//  UCIe-facing).
//
//  Routing is ROUTE-001's O1TURN-XY with the injection-time overlay, at
//  the shipping default ROUTE_PATH_EN = 0b111.
//
//  VC policy is "rank", which is the only setting that keeps all three
//  path shapes concurrently live and provably deadlock-free. It is NOT
//  what Plane D ships -- Plane D has no VCs at all -- so read this as
//  "the fabric Srota would have if RT-R7 is resolved by conceding VCs."
//  For the shippable configurations see srota_rtr7_*.config.
// ----------------------------------------------------------------------

topology = srota;
routing_function = o1turn;

k = 16;                     // TOPO-003 5: mesh radix, validated 4-32
c = 4;                      // TOPO-003 5: concentration -> 1024 tiles

srota_mecs           = 3;   // TOPO_MECS_ENABLE: row + column express
srota_drop_latency   = 1;   // TOPO_DROP_LATENCY: single-cycle drop
// TOPO_ISLAND_COL_MAP. The config parser is decimal-only, so this is a
// bitmap written out: 2 + 256 = columns 1 and 8 (TOPO-003 4.3, one
// HBM-facing island column and one UCIe-facing).
srota_island_col_map = 258;

srota_path_en     = 7;      // ROUTE_PATH_EN = 0b111, the shipping default
srota_cong_thresh = 8;      // ROUTE_CONGESTION_THRESH reset value, 0x8
srota_epoch_len   = 1024;   // ROUTE_EPOCH_LEN
srota_vc_policy   = rank;   // see the design note in networks/srota.hpp

srota_tel_period  = 4;      // Plane T at 1 GHz vs Plane D at 4 GHz
srota_tel_latency = 8;      // fixed ring-tree depth (TEL-004 3)

// Rank policy with Valiant enabled needs 4 disjoint VC sets.
num_vcs     = 8;
vc_buf_size = 8;
wait_for_tail_credit = 0;

vc_allocator = islip;
sw_allocator = islip;
alloc_iters  = 1;

routing_delay    = 1;       // must stay > 0: MECS taps defeat lookahead
vc_alloc_delay   = 1;
sw_alloc_delay   = 1;
credit_delay     = 1;
st_prepare_delay = 0;
st_final_delay   = 1;

input_speedup    = 1;
output_speedup   = 1;
internal_speedup = 1.0;

hold_switch_for_packet = 0;
buffer_policy = private;
channel_width = 512;        // TOPO-003 5: D-link width default

use_noc_latency = 0;        // this model has no wire-length model

traffic        = uniform;
packet_size    = 5;
injection_rate = 0.05;

sim_type       = latency;
warmup_periods = 3;
sample_period  = 1000;
sim_count      = 1;
