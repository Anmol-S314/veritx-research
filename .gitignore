# VeritX Research — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
dist/
build/
.venv*/
venv/
*.so

# Build artifacts
*.o
*.a
*.d

# Results (generated by CI)
results/
report/
runs/
m5out/
formal_logs/

# Generated simulation output
*.log
*.bak
*.tmp
*.orig
*~
flits.txt
trace.txt
timeloop-mapper.*

# Scratch / experiment directories
.scratch/
.noc_p0/
.booksim_m3/
.experiments/
playwright-mcp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.key
veritx-tools-base.tar

# Local binaries (gh, glab, gitlab-runner)
bin/

# Generated docs
CHANGELOG.md
LICENSE

# Confidential programme docs
VeritX_BTech_6Month_Programme.txt

# Old vendored tools (20GB, not needed)
vendor-archive/

# Verilator build output
obj_dir/
obj_dir_*/

# RTL generation output
tracks/t3-topology/scripts/rtlgen/mesh_*/
tracks/t3-topology/scripts/rtlgen/.noc_*/
tracks/t3-topology/scripts/rtlgen/router_formal/

# Formal verification output
*.sby/
status
status.sqlite
ERROR
logfile.txt

# Symlinks to other dirs
serving/LLMServingSim/astra-sim/

# VM setup docs contain plaintext infra credentials - do not track
/docs/VM-SETUP.md
# Archived docs (incl. the old VM-SETUP.md) - keep out of the tree
/docs/archive/

# Build-time binary provenance manifests (per-binary build artifacts)
*.build-manifest.json
