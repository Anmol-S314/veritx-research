# VeritX Research — .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv*/
venv/
*.so

# Results (generated by CI)
results/
report/
m5out/
formal_logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.key
veritx-tools-base.tar

# Local binaries (gh, glab, gitlab-runner)
bin/

# Generated docs
CHANGELOG.md

# Confidential programme docs
VeritX_BTech_6Month_Programme.txt
tracks/t3-topology/timeloop/timeloop-mapper.*

# Teaching materials & local setup notes — kept on disk, NOT pushed to the remote
curriculum/

# Contains plaintext infra credentials — keep local, never commit
docs/VM-SETUP.md

# Vendored toolchains kept OUT of the monorepo (provenance: docs/research/toolchain-provenance.md)
third_party/pytorchsim/

# One-off RTL debugging probes — provenance lives in commits + RTL-ARC.md
r1_*.sh
watch.log
rtl_flits*.txt
third_party/booksim2/src/watch.log

# Root-level run dumps (from gate runs executed at repo root) — provenance lives in manifest.txt
/flits.txt
/trace.txt

# Playwright MCP session junk (console/page logs)
.playwright-mcp/
