  "conservation_laws": [
    {
      "id": "L1",
      "name": "rank_cardinality",
      "relation": "R = TP*PP*EP*DP",
      "proof": "PROVED_EXACT"
    },
    {
      "id": "L2",
      "name": "rank_bijection",
      "relation": "coords(rank(c)) == c",
      "proof": "BOUNDED_EXHAUSTIVE"
    },
    {
      "id": "L3",
      "name": "mapping_completeness",
      "relation": "len == R and injective",
      "proof": "PROVED_EXACT"
    },
    {
      "id": "L4",
      "name": "group_membership",
      "relation": "sum(sizes) == R per family",
      "proof": "PROVED_EXACT"
    },
    {
      "id": "L5",
      "name": "collective_participants",
      "relation": "schedule participants == intent",
      "proof": "PROPERTY_VALIDATED"
    },
    {
      "id": "L6",
      "name": "moe_assignments",
      "relation": "tokens*k; sent == received",
      "proof": "PROVED_EXACT",
      "domain": "EXPLICIT_TRACE, no drop"
    },
    {
      "id": "L7",
      "name": "message_payload",
      "relation": "sum(message payload) == op logical bytes",
      "proof": "PROVED_EXACT"
    },
    {
      "id": "L8",
      "name": "packet_payload",
      "relation": "N == ceil(message_bits/(Q*L)); sum(payload_bits) == message_bits",
      "proof": "PROVED_EXACT",
      "unit": "bits"
    },
    {
      "id": "L9",
      "name": "transmitted_bits",
      "relation": "n_i*F == n_i*H + P_i + padding_i",
      "proof": "PROVED_EXACT",
      "unit": "bits"
    },
    {
      "id": "L10",
      "name": "flit_padding",
      "relation": "padding_i == n_i*Q - P_i; 0 <= padding_i < Q",
      "proof": "PROVED_EXACT",
      "unit": "bits"
    },
    {
      "id": "L10b",
      "name": "collective_aggregate",
      "relation": "per-kind aggregate network payload (see collectives.schedules)",
      "proof": "PROVED_EXACT",
      "domain": "B % k == 0 where required"
    },
    {
      "id": "L11",
      "name": "multicast_delivery",
      "relation": "delivered == payload*N",
      "proof": "PROVED_EXACT",
      "domain": "SOURCE_REPLICATION"
    },
    {
      "id": "L12",
      "name": "kv_ownership",
      "relation": "produced == resident + transferred + discarded",
      "proof": "PROVED_EXACT"
    },
    {
      "id": "L13",
      "name": "quiescence",
      "relation": "submitted == completed",
      "proof": "DIFFERENTIALLY_VALIDATED"
    }
  ],
  "proof_classes": [
