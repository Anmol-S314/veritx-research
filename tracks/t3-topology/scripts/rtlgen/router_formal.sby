[options]
mode bmc
depth 20
# Run from THIS directory (paths below are sby-dir-relative):
#   cd scripts/rtlgen && sby -f router_formal.sby
# Current blocker (2026-09-14): yosys rejects router.sv:59 (syntax error,
# unexpected TOK_ID) before any engine runs — the checked-in RTL needs a
# SystemVerilog-capable frontend pass before these proofs mean anything.

[engines]
smtbmc

[script]
read -sv noc_pkg.sv
read -sv router.sv
hierarchy -top router

[files]
noc_pkg.sv
router.sv
