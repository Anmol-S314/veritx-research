// Srota NoC -- Plane D with DEFLECTION (misrouting).
//
// The side-buffer arms (srota16_xy, srota16_sb) leave the side buffer
// almost untouched: the 2-flit staging window throttles each input hard
// enough that switch-allocation contention rarely happens, and the side
// buffer only ever captures switch-allocation LOSERS. So the mechanism
// under evaluation never fires. See SROTA.md, "Deflection".
//
// Deflection attacks that directly. A packet whose productive port has
// no credit takes a non-productive port instead of waiting, so it stays
// in the switch competing every cycle rather than stalling on credit.
// Contention goes up, and with it the side buffer's fill rate.
//
// DEADLOCK: deflected routes make the channel-dependency graph complete,
// so acyclicity is bought with a Duato escape network instead. VC 0
// carries the deterministic route and is never deflected; VC 1 is the
// adaptive VC. Every adaptive packet can always request VC 0 on its
// productive port, so a cycle among adaptive VCs can always drain. The
// F1 check at elaboration proves the escape subgraph (pure XY over MECS,
// one VC) acyclic -- which is exactly srota16_xy's routing.
//
// LIVELOCK: srota_deflect_max bounds deflections per packet. At the
// budget the packet is minimal-only, so its remaining hop count is the
// minimal distance.
//
// STORAGE: 7 ports x 2 VC x 2 flits + 8 side buffer = 36 flits/router,
// 576 total -- deliberately identical to srota16_sb.cfg, so the two are
// a like-for-like comparison of what the SECOND VC is spent on:
// rank separation (sb) versus an escape network for deflection (this).
//
// 16 terminals (k=4, c=1) to match the 16x16 Timeloop traffic matrix.

topology = srota;
routing_function = o1turn;

k = 4;
c = 1;

srota_planes    = 5;        // D + T
srota_mecs      = 3;        // row + column express
srota_path_en   = 1;        // row-first only = XY over MECS; required
srota_vc_policy = none;     // required: deflection partitions the VC
                            // space itself, and the two partitions do
                            // not compose
srota_cdg_radix = 4;        // F1 on the escape subgraph, every run

srota_deflect          = 1;
srota_deflect_max      = 4; // per-packet budget; the livelock bound
srota_deflect_esc_vcs  = 1; // VC 0 = escape, VC 1 = adaptive

srota_router       = sidebuf;
num_vcs            = 2;     // 1 escape + 1 adaptive -- the minimum
vc_buf_size        = 2;     // the staging latch (VC-002 2.2, fixed at 2)
srota_sb_depth     = 8;     // shared side buffer (VC-002 2.3)
srota_sb_watermark = 6;

use_noc_latency = 0;        // required; set for every arm via BOOKSIM_EXTRA

traffic = uniform;          // overridden by TRAFFIC_MATRIX in the spine
injection_rate = 0.1;
packet_size = 5;

sim_type = latency;
sample_period = 1000;
warmup_periods = 3;
