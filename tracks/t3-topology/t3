#!/usr/bin/env bash
# =============================================================================
# t3  —  top-level CLI for the T3 Topology track
#
# Transparent Container Execution:
# Sourcing run/env.sh puts 't3' on your PATH.
# When invoked from your host terminal, 't3' automatically routes the command
# inside the veritx-tools-base container using your host UID/GID so all dependencies
# (Timeloop, Accelergy, Booksim, etc.) are available and file permissions remain clean.
#
# Usage (from ANY directory on host or container):
#   source /path/to/tracks/t3-topology/run/env.sh
#   t3 <command> [options]
#   t3 exec <any command inside shell>
# =============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# 1. Resolve T3_DIR & REPO_ROOT
# ---------------------------------------------------------------------------
# readlink -f: resolve symlinks (e.g. ~/.local/bin/t3) so paths work from anywhere.
_T3_SRC="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then _T3_SRC="$(readlink -f "$_T3_SRC")"; fi
T3_SCRIPT_PATH="$(cd "$(dirname "$_T3_SRC")" && pwd)/$(basename "$_T3_SRC")"
T3_DIR="$(cd "$(dirname "$T3_SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$T3_DIR/../.." && pwd)"

# Source run/env.sh if present
_T3_ENV="$T3_DIR/run/env.sh"
if [ -f "$_T3_ENV" ]; then
    source "$_T3_ENV" >/dev/null 2>&1 || true
fi
unset _T3_ENV

# ---------------------------------------------------------------------------
# 2. Container transparent dispatch
# ---------------------------------------------------------------------------
IN_CONTAINER=0
if [ -f /.dockerenv ] || [ -f /run/.containerenv ]; then
    IN_CONTAINER=1
fi

if [ "$IN_CONTAINER" -eq 0 ]; then
    CONTAINER_BIN="${CONTAINER_BIN:-$(command -v podman 2>/dev/null || command -v docker 2>/dev/null || echo docker)}"
    IMAGE="${IMAGE:-ghcr.io/anmol-s314/veritx-tools-base:latest}"

    TTY_FLAG=""
    if [ -t 0 ] && [ -t 1 ]; then
        TTY_FLAG="-it"
    fi

    # Rootless podman remaps -u UID:GID into the subuid range, so the
    # container identity owns nothing on the host bind mount (EACCES on every
    # results/ write).  keep-id preserves the host identity; docker needs the
    # explicit -u since it runs as root by default.
    if [ "${CONTAINER_BIN##*/}" = "podman" ]; then
        USER_FLAG="--userns=keep-id"
    else
        USER_FLAG="-u $(id -u):$(id -g)"
    fi

    EXEC_ENV=(
        -e CONFIG="${CONFIG:-baseline}"
        -e RATES="${RATES:-0.002,0.005,0.01,0.02,0.03}"
        -e SAT_K="${SAT_K:-2.0}"
        -e PACKET_SIZE_BITS="${PACKET_SIZE_BITS:-128}"
        -e MPLBACKEND="${MPLBACKEND:-Agg}"
        -e MPLCONFIGDIR="/tmp"
        -e TERM="${TERM:-xterm-256color}"
        -e HOME="/tmp"
        -e MODEL="${MODEL:-}"
        -e TOPO="${TOPO:-}"
        -e SIZES="${SIZES:-}"
        # workload-registry (model-add) knobs — headless/guided definition
        -e MODEL_NAME="${MODEL_NAME:-}"
        -e MODEL_BASE="${MODEL_BASE:-}"
        -e MODEL_DISPLAY="${MODEL_DISPLAY:-}"
        -e MODEL_MSG_MB="${MODEL_MSG_MB:-}"
        -e MODEL_HIDDEN="${MODEL_HIDDEN:-}"
        -e MODEL_FFN="${MODEL_FFN:-}"
        -e MODEL_LAYERS="${MODEL_LAYERS:-}"
        -e MODEL_SEQ="${MODEL_SEQ:-}"
        -e MODEL_BATCH="${MODEL_BATCH:-}"
        -e MODEL_TP="${MODEL_TP:-}"
        -e MODEL_PP="${MODEL_PP:-}"
        # Host checkout path: the container sees it as /workspace, but the
        # user's browser/image viewer lives on the host — _open_png and
        # cmd_dashboard translate container paths back with this.
        -e T3_HOST_ROOT="$REPO_ROOT"
    )

    # astrasim special case: the AstraSim_BookSim2 frontend is built on the
    # host and dynamically links host protobuf (libprotobuf.so.32) that the
    # container image does not carry — inside the container it cannot even
    # load, so every run reports `failed | 1000 cycles`. When the binary is
    # host-runnable, run the spine natively; otherwise fall through to the
    # container (covers container-built frontends).
    # Sentinel from the fast-path below: the AstraSim_BookSim2 frontend was
    # just PROVEN host-runnable (ldd clean), so this re-entry must NOT hop
    # into the container (its old glibc can't load the frontend anyway) —
    # skip straight to in-container-execution code (normal dispatch), which
    # lands in cmd_astrasim: the ONE execution path that owns the full flag
    # contract (env defaults + MODEL_* overrides + forwarded "$@").
    if [ "${T3_ASTRASIM_NATIVE:-}" = "1" ]; then
        IN_CONTAINER=1  # reuse the in-container skip; we are executing natively
    elif [ "${1:-}" = "astrasim" ]; then
        _asim_bin="$REPO_ROOT/third_party/astra-sim/astra-sim/network_frontend/booksim2/bin/AstraSim_BookSim2"
        if [ -x "$_asim_bin" ] && ! ldd "$_asim_bin" 2>/dev/null | grep -q "not found"; then
            echo "  [t3] host-runnable AstraSim_BookSim2 detected -> native execution"
            # ONE execution path: re-enter with a sentinel so the special
            # case doesn't fire again, then normal dispatch lands in
            # cmd_astrasim, which owns the full flag contract (CONFIG/MODEL/
            # TOPO/SIZES/MODEL_* overrides + forwarded "$@"). The old inline
            # exec rebuilt a partial command line and silently dropped any
            # user flags (e.g. 't3 astrasim --tp 8 --seq-len 4096').
            T3_ASTRASIM_NATIVE=1 ASTRASIM_BIN="$_asim_bin" exec "$T3_SCRIPT_PATH" astrasim "${@:2}"
        fi
    fi
    # Web UI: a server must run where the browser can reach it. Inside the
    # container its port wouldn't be published, so run it natively (stdlib
    # only — needs no containerized tools). --webcmd jobs, in contrast, are
    # normal t3 commands: they hop into the container like everything else.
    if [ "${1:-}" = "webui" ]; then
        shift
        exec python3 "$T3_DIR/scripts/t3_web.py" "$@"
    fi
    # (TRAFFIC_MATRIX forwarding lives in _forward_path below: mount + env together.)

    # Interactive container shell target
    if [ "${1:-}" = "shell" ] || [ "${1:-}" = "bash" ]; then
        exec $CONTAINER_BIN run $TTY_FLAG --rm $USER_FLAG \
            -v "$REPO_ROOT":/workspace \
            -w /workspace/tracks/t3-topology \
            "${EXEC_ENV[@]}" \
            "$IMAGE" bash
    fi

    # Publish the web-UI port when free: the in-container menu serves it
    # (T3_WEBUI_PUBLIC) and port mapping is create-time only, so a menu
    # container started without -p could never serve the host browser.
    # Loopback-only on the host side. If something already holds 8517
    # (e.g. your own native server), start without it — T3_PORT_PUBLISHED
    # tells the menu not to launch an unreachable twin.
    # (Top-level if-body: `local` is illegal here — plain assignment.)
    _port_flags=()
    if (ss -ltn 2>/dev/null || netstat -ltn 2>/dev/null) | grep -q ":8517"; then
        EXEC_ENV+=(-e T3_PORT_PUBLISHED=0)
    else
        _port_flags=(-p 127.0.0.1:8517:8517)
        EXEC_ENV+=(-e T3_PORT_PUBLISHED=1)
    fi
    # Portable paths (claim-4 fix): the container sees ONLY $REPO_ROOT,
    # mounted at /workspace. Host-absolute paths would otherwise silently
    # vanish inside: t3 sources run/env.sh on the HOST at startup, which
    # exports e.g. BOOKSIM_BIN=/home/... — forwarding that verbatim broke
    # every container consumer (invisible path), while veritx's own
    # /workspace-anchored resolution kept working. Rule: repo paths are
    # TRANSLATED to their /workspace twin (same bind-mounted bytes, no
    # extra mount needed); computed defaults are skipped (the container
    # derives them identically); anything else bind-mounts its nearest
    # existing ancestor at the SAME path — except under system dirs
    # (/, /usr, /opt, …), which only warn (mounting host system dirs over
    # the image would break it; downstream "not found" errors stay loud).
    # T3_RESULTS/T3_OUTPUT are absent from EXEC_ENV (the container derives
    # them), so custom values must be forwarded here otherwise they're lost.
    _extra_mounts=()
    _forward_path() { # VARNAME [default-value...]
        local _var="$1" _val="${!1:-}" _anc _fwd; shift
        [ -z "$_val" ] && return 0
        local _d
        for _d in "$@"; do [ "$_val" = "$_d" ] && return 0; done
        case "$_val" in
            "$REPO_ROOT"/*) _fwd="/workspace${_val#$REPO_ROOT}" ;;
            */*) ;;
            *) return 0 ;;  # bare name: container-side lookup, nothing to do
        esac
        if [ -z "${_fwd:-}" ]; then
            _anc="$_val"
            while [ ! -e "$_anc" ] && [ "$_anc" != "/" ] && [ "$_anc" != "." ]; do _anc=$(dirname "$_anc"); done
            case "$_anc" in /|/usr|/bin|/sbin|/etc|/lib|/lib64|/opt|/root|/proc|/sys|/dev)
                echo "  [t3] $_var=$_val is outside the repo under a system dir — NOT mounted; " >&2
                echo "  if the container can't see it, move it under $REPO_ROOT." >&2
                return 0 ;;
            esac
            _extra_mounts+=(-v "$_anc:$_anc")
            _fwd="$_val"
        fi
        EXEC_ENV+=(-e "$_var=$_fwd")
        # Explicit user value: mark it so in-container _dispatch does NOT
        # re-derive (and clobber) it from CONFIG — the custom dir must win.
        # (if, not '&&': a false test here must not become the function's
        # return status — callers run '_forward_path X || exit 1'.)
        if [ "$_var" = "T3_RESULTS" ]; then EXEC_ENV+=(-e T3_RESULTS_EXPLICIT=1); fi
    }
    _forward_path T3_RESULTS "$REPO_ROOT/tracks/t3-topology/results/${CONFIG:-baseline}" || exit 1
    _forward_path T3_OUTPUT "$REPO_ROOT/tracks/t3-topology/results/${CONFIG:-baseline}/analysis" || exit 1
    # BOOKSIM_BIN: the host default (repo bind-mount binary) is a COMPUTED
    # default — never forward it. The host-built binary needs a newer
    # libstdc++/glibc (GLIBCXX_3.4.32, GLIBC_2.38) than the Ubuntu-22.04
    # image provides, so forwarding it breaks every in-container BookSim
    # run. Skipped here, the container's env.sh derives its image-native
    # binary (/usr/local/bin/booksim). An explicit user override (custom
    # path) still forwards as before.
    _forward_path BOOKSIM_BIN "$REPO_ROOT/third_party/booksim2/src/booksim" "booksim" || exit 1
    _forward_path TRAFFIC_MATRIX || exit 1
    # Dispatch any t3 command or raw command into the container
    exec $CONTAINER_BIN run $TTY_FLAG --rm $USER_FLAG \
        -v "$REPO_ROOT":/workspace \
        "${_extra_mounts[@]}" \
        -w /workspace/tracks/t3-topology \
        "${EXEC_ENV[@]}" \
        "${_port_flags[@]}" \
        "$IMAGE" \
        bash -c 'source run/env.sh >/dev/null 2>&1 && exec t3 "$@"' _ "$@"
fi

# ---------------------------------------------------------------------------
# 3. Inside container execution below:
# ---------------------------------------------------------------------------
# env.sh exports T3_RESULTS; a shell that skipped it must not die with an
# unbound-variable error one frame into every command — default defensively.
: "${T3_RESULTS:=$T3_DIR/results/${CONFIG:-baseline}}"
T3_OUTPUT="${T3_OUTPUT:-$T3_RESULTS/analysis}"
mkdir -p "$T3_OUTPUT" 2>/dev/null || true

# Helpers
_py() {
    "$T3_PYTHON" "$@"
}

_banner() {
    # Phase 3a: status goes to stderr so stdout stays machine-clean for
    # scripts that capture `t3 ...` output. Texts unchanged, fd only.
    {
    echo ""
    echo "  ╔══════════════════════════════════╗"
    printf  "  ║  %-32s  ║\n" "$1"
    echo "  ╚══════════════════════════════════╝"
    echo ""
    } >&2
}

_ok()   { echo "  ✓  $*" >&2; }
_warn() { echo "  ⚠  $*" >&2; }
_err()  { echo "  ✗  $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 2a. Single source for t3 command routing (Phase 3a unification).
# _dispatch, _run_line, _ui_runner, and _WEBCMDS all derive from these two
# lists — there is no second dispatch table to drift. The veritx verb list
# (_vsubs in _ui_runner) is NOT hardcoded here: _veritx_verbs() sources it
# live from `veritx --list-commands` (canonical COMMANDS registry in
# dse/veritx_dse/cli/cli.py), with a hardcoded fallback that `t3 selfcheck`
# diffs against the live registry and fails loudly on drift.
# ---------------------------------------------------------------------------
# Native t3-only commands (menu/wizard/t3 wrappers). Every entry must have a
# cmd_* function (dashes map to underscores; see _dispatch aliases for
# pa-report→cmd_report and exec/run→cmd_exec). `veritx` itself is native
# (cmd_veritx forwards losslessly via `veritx "$cmd" "$@"`).
_T3_NATIVE="menu start-here env check analysis plot-config viz viz-open compare-curves compare-bars compare-heat quick-compare webui veritx-serve model model-add logs logs-prune aggregate plot sim timeloop timeloop-workload timeloop-spatial astrasim report pa-report dashboard energy selfcheck veritx lint clean exec run help"
# Blocklist: veritx subpaths (slash-joined, e.g. evaluate/astra) that t3
# refuses to forward. Currently EMPTY — even evaluate/astra forwards
# (UNBLOCKED by forwarding): the python CLI fails fast with a clear message
# when the host frontend is missing, so direct `t3 veritx evaluate astra …`
# is safe. The INTERACTIVE builder (_veritx_sub "evaluate astra" branch)
# still guides container users to run natively with a reason (container libs
# too old) instead of burning the timeout — that builder-only guard is
# intentional and documented there, not a dispatch block. If a veritx command
# ever needs a hard dispatch block, add its slash-path here with a reason
# comment and _dispatch will refuse it loudly.
_T3_BLOCKED="legacy/run legacy/sweep legacy/compare legacy/pareto legacy/compile legacy/baseline legacy/diff legacy/serve legacy/synthesize-bo legacy/synthesize-iterative legacy/synthesize-compile legacy/evaluate-booksim legacy/evaluate-anynet legacy/evaluate-astra legacy/topology-diff legacy/api-execute legacy/api-compare legacy/api-compile legacy/api-validate legacy/api-plan legacy/api-run legacy/api-results legacy/api-diagnose legacy/api-export legacy/api-capabilities legacy/api-workloads legacy/api-topologies legacy/certify-flow legacy/certify-rtl legacy/certify-full legacy/runs legacy/results legacy/status legacy/history legacy/report"

_veritx_verbs_fallback() { # the ONE literal fallback verb list (selfcheck diffs it)
    echo "api compile doctor generate init interact legacy migrate-design optimize service topology trace where"
}

_veritx_verbs() { # -> space-separated veritx top-level verbs, live from registry
    # Canonical source: `veritx --list-commands` (COMMANDS in cli.py).
    # Fallback below must match it exactly — `t3 selfcheck` diffs them.
    local _raw
    _raw=$(cd "$T3_DIR" 2>/dev/null && PYTHONPATH="$T3_DIR/dse${PYTHONPATH:+:$PYTHONPATH}" "$T3_PYTHON" -m veritx_dse.cli --list-commands 2>/dev/null | "$T3_PYTHON" -c 'import json,sys; d=json.load(sys.stdin); print(" ".join(sorted({r["name"].split()[0] for r in d})))' 2>/dev/null) || _raw=""
    if [ -n "$_raw" ]; then
        echo "$_raw"
    else
        _veritx_verbs_fallback
    fi
}

_t3_registry_selfcheck() { # diff t3 tables vs veritx --list-commands; rc=1 on drift
    local _fail=0 _live _verbs _fb
    _live=$(cd "$T3_DIR" && PYTHONPATH="$T3_DIR/dse${PYTHONPATH:+:$PYTHONPATH}" "$T3_PYTHON" -m veritx_dse.cli --list-commands 2>/dev/null) || {
        echo "  ✗ selfcheck: cannot query veritx --list-commands" >&2; return 1; }
    _verbs=$(echo "$_live" | "$T3_PYTHON" -c 'import json,sys; d=json.load(sys.stdin); print(" ".join(sorted({r["name"].split()[0] for r in d})))')
    # 1. Fallback verbs must match live registry (keeps headless fallback fresh).
    # ONE copy of the fallback string, shared with _veritx_verbs: keep this
    # comparison exact against the same literal the fallback prints.
    _fb="$(_veritx_verbs_fallback)"
    # Normalize (sort) both sides before comparing — registry order is insertion, fallback is alpha.
    if [ "$(echo "$_fb" | tr ' ' '\n' | sort | tr '\n' ' ')" != "$(echo "$_verbs" | tr ' ' '\n' | sort | tr '\n' ' ')" ]; then
        echo "  ✗ selfcheck: veritx verb drift — live '${_verbs}' vs fallback '${_fb}'" >&2
        echo "    update _veritx_verbs() fallback and _ui_runner to match cli.py COMMANDS" >&2
        _fail=1
    fi
    # 2. Every _T3_NATIVE entry must resolve to a cmd_* function (aliases mapped).
    local _c _fn
    for _c in $_T3_NATIVE; do
        case "$_c" in
        pa-report) _fn=cmd_report ;;
        exec|run) _fn=cmd_exec ;;
        *) _fn="cmd_${_c//-/_}" ;;
        esac
        if ! declare -F "$_fn" >/dev/null; then
            echo "  ✗ selfcheck: native '$_c' has no function '$_fn'" >&2
            _fail=1
        fi
    done
    # 3. Every _WEBCMDS entry must be a subset of _T3_NATIVE (web never gains clean/exec).
    local _w
    for _w in ${_WEBCMDS[*]}; do
        # Normalize web names (compare_curves) to t3 dispatch names (compare-curves).
        local _wd="${_w//_/-}"
        case " ${_T3_NATIVE} " in
        *" $_w "*|*" $_wd "*) ;;
        *) echo "  ✗ selfcheck: webcmd '$_w' not in _T3_NATIVE" >&2; _fail=1 ;;
        esac
    done
    # 4. Blocked paths (if any) must exist in the live registry (no stale blocks).
    local _b
    for _b in $_T3_BLOCKED; do
        local _bsp="${_b//\// }"
        if ! echo "$_live" | grep -q "\"name\": \"$_bsp\""; then
            echo "  ✗ selfcheck: blocked '$_b' not in veritx registry (stale block)" >&2
            _fail=1
        fi
    done
    return $_fail
}

# ---------------------------------------------------------------------------
# 2b. TUI kit — alt-screen primitives, pickers, state, guided builders.
# Defined at global scope so both the menu and standalone commands share them.
# ---------------------------------------------------------------------------
_UI_ON=0
_IN_MENU=0
_EXPLICIT=""
_ui_enter() { tput smcup 2>/dev/null || printf '\033[?1049h'; printf '\033[?25l'; _UI_ON=1; _ui_clear; }
_ui_leave() { [ "$_UI_ON" -eq 1 ] || return 0; printf '\033[?25h'; tput rmcup 2>/dev/null || printf '\033[?1049l'; _UI_ON=0; }
_ui_clear() { printf '\033[H\033[2J'; }
_ui_open() { # run _RUN outside the alt screen; report status; wait; resume menu
    local _kp _rc=0
    _RUN_NAME="${_RUN_NAME:-t3}"
    _RUN=("${_RUN[@]:-_dispatch help}")
    _ui_leave
    printf '  \033[1m── t3 %s\033[0m\n' "${_RUN_NAME:-${_RUN[*]}}"
    printf '  \033[2m[CONFIG=%s MODEL=%s TOPO=%s RATES=%s]\033[0m\n' \
        "${CONFIG:-baseline}" "${MODEL:-all_reduce}" "${TOPO:-all}" "${RATES:-0.002,0.005,0.01,0.02,0.03}"
    ( "${_RUN[@]}" ) || _rc=$?
    echo ""
    if [ "$_rc" -eq 0 ]; then _ok "done."; else echo "  ✗  failed (exit $_rc)"; fi
    printf '  \033[2m⏎ continue\033[0m'
    IFS= read -rsn1 _kp || true
    echo ""
    if [ "$_IN_MENU" -eq 1 ]; then
        _ui_enter
        _need_draw=1
    fi
}

_ui_page_start() { # shared pager state: _sel, filtered _m[], render window [_top.._top+_rows)
    # Cursor walks the FULL filtered list; the render window follows it so a
    # long list can never select an off-screen row (the old fixed :0:10 slice
    # let ↑↓ walk invisible items).
    _ui_rows=10
}
_ui_page_ensure() { # keep _sel inside the visible window by scrolling _top
    local _n=${#_m[@]}
    (( _n <= _ui_rows )) && { _top=0; return 0; }  # filter shrank the list: reset
    while [ "$_sel" -lt "$_top" ]; do _top=$((_top - 1)); done
    while [ "$_sel" -ge "$((_top + _ui_rows))" ]; do _top=$((_top + 1)); done
    [ "$_top" -lt 0 ] && _top=0
    [ "$_top" -gt $((_n - _ui_rows)) ] && _top=$((_n - _ui_rows))
    return 0
}
_ui_pick() { # _ui_pick label seed items... -> $_PICK; rc=1 cancel
    # Immutable copy of the suggested default: _q is the live filter buffer
    # (backspace clears it), so the footer keeps showing what ⏎ falls back to.
    local _label="$1" _q="$2" _def0="$2"; shift 2
    local _items=("$@") _sel=0 _m=() _c _k _k2 _i _n _fresh=1
    local _top=0; _ui_page_start
    _PICK=""
    if [ ! -t 0 ]; then
        # Non-interactive (webui jobs, scripts, pipes): no live pickers.
        # Print the options and take the builder's default so guided
        # builders still run headlessly instead of silently no-op'ing.
        printf '  %s\n' "$_label"
        _i=1
        for _c in "${_items[@]:0:12}"; do printf '    %d) %s\n' "$_i" "$_c"; _i=$((_i + 1)); done
        _PICK="$_q"
        printf '  (non-interactive: using default → %s)\n' "$_PICK"
        return 0
    fi
    while true; do
        _m=()
        for _c in "${_items[@]}"; do
            case "$_c" in *"$_q"*) _m+=("$_c");; esac
        done
        [ "$_sel" -ge "${#_m[@]}" ] && _sel=0
        _ui_page_ensure
        _ui_clear
        printf '  \033[1m%s\033[0m\n' "$_label"
        printf '  ────────────────────────────────────────────────────────────\n'
        if [ "$_fresh" -eq 1 ] && [ -n "$_q" ]; then
            printf '  › \033[2m%s\033[0m  \033[2m(type to replace · ⏎ keep)\033[0m\n' "$_q"
        else
            printf '  › %s\n' "$_q"
        fi
        printf '\n'
        if [ "${#_m[@]}" -eq 0 ]; then
            printf '  \033[2mno match — ⏎ uses what you typed\033[0m\n'
        else
            _n=$_top
            for _c in "${_m[@]:$_top:_ui_rows}"; do
                if [ "$_n" -eq "$_sel" ]; then printf '  \033[7m ▸ %s\033[0m\n' "$_c"
                else printf '    %s\n' "$_c"; fi
                _n=$((_n + 1))
            done
            [ "${#_m[@]}" -gt "$_ui_rows" ] && printf '  \033[2m(%d/%d · ↑↓ scrolls)\033[0m\n' "$((_sel + 1))" "${#_m[@]}"
        fi
        printf '\n  \033[2m↑↓ move · ⏎ pick · tab complete · esc cancel'
        # Default reminder — but only when the input line isn't already
        # showing it (fresh + seed visible). Otherwise it's just noise.
        if [ -n "$_def0" ] && [ "$_fresh" -eq 0 ]; then
            printf ' · \033[2mdefault: %s\033[0m' "${_def0:0:44}"
        fi
        printf '\033[0m'
        # Exit with a trailing newline: the footer is printed live (no \n so
        # the default-reminder can append), but leaving the cursor on that
        # line glued the NEXT prompt onto it ("…esc cancel  sim overrides…").
        IFS= read -rsn1 _k || { printf '\n'; _PICK=""; return 1; }
        case "$_k" in
        '') if [ "${#_m[@]}" -gt 0 ]; then _PICK="${_m[$_sel]}"
            elif [ -n "$_q" ]; then _PICK="$_q"
            else printf '\n'; _PICK=""; return 1; fi
            printf '\n'
            return 0 ;;
        $'\x7f'|$'\b') if [ "$_fresh" -eq 1 ]; then _q=""; _fresh=0; else _q="${_q%?}"; fi; _sel=0 ;;
        $'\x1b') if IFS= read -rsn2 -t 0.05 _k2; then
                case "$_k2" in
                '[A') _sel=$((_sel - 1)); [ "$_sel" -lt 0 ] && _sel=$((${#_m[@]} - 1)) ;;
                '[B') _sel=$((_sel + 1)); [ "$_sel" -ge "${#_m[@]}" ] && _sel=0 ;;
                esac
            else
                printf '\n'; _PICK=""; return 1  # bare esc cancels
            fi ;;
        $'\t') [ "${#_m[@]}" -gt 0 ] && { _q="${_m[$_sel]}"; _fresh=0; _sel=0; } ;;
        $'\x03'|$'\x04') printf '\n'; _PICK=""; return 1 ;;
        *) case "$_k" in [![:cntrl:]])
               if [ "$_fresh" -eq 1 ]; then _q="$_k"; _fresh=0
               else _q="$_q$_k"; fi
               _sel=0 ;;
           esac ;;
        esac
    done
    _PICK=""; return 1
}

_ui_multi() { # _ui_multi label pre-csv items... -> _PICKS; rc=1 cancel
    local _label="$1" _pre="$2"; shift 2
    if [ "$#" -eq 0 ]; then # empty list: the old dead-end where ⏎ looped
        printf '  %s — \033[2mnone available\033[0m\n' "$_label"
        _PICKS=()
        return 1
    fi
    local _items=("$@") _q="" _sel=0 _m=() _c _k _k2 _n _f _x
    local _top=0; _ui_page_start; _ui_rows=12
    local _picked=() _np=()
    [ -n "$_pre" ] && IFS=',' read -ra _picked <<< "$_pre"
    _PICKS=()
    if [ ! -t 0 ]; then
        # Non-interactive: use the builder's pre-selected set.
        printf '  %s\n' "$_label"
        _n=1
        for _c in "${_items[@]:0:12}"; do printf '    %d) %s\n' "$_n" "$_c"; _n=$((_n + 1)); done
        _PICKS=("${_picked[@]}")
        printf '  (non-interactive: using default → %s)\n' "${_pre:-none}"
        return 0
    fi
    while true; do
        _m=()
        for _c in "${_items[@]}"; do case "$_c" in *"$_q"*) _m+=("$_c");; esac; done
        [ "$_sel" -ge "${#_m[@]}" ] && _sel=0
        _ui_page_ensure
        _ui_clear
        printf '  \033[1m%s\033[0m  \033[2m(%d picked)\033[0m\n' "$_label" "${#_picked[@]}"
        printf '  ────────────────────────────────────────────────────────────\n'
        if [ -n "$_q" ]; then printf '  › %s\n\n' "$_q"; else printf '\n'; fi
        if [ "${#_m[@]}" -eq 0 ]; then
            printf '  \033[2mno match — type to filter, esc cancels\033[0m\n'
        else
            _n=$_top
            for _c in "${_m[@]:$_top:_ui_rows}"; do
                _f=' '; for _x in "${_picked[@]}"; do [ "$_x" = "$_c" ] && _f='x'; done
                if [ "$_n" -eq "$_sel" ]; then printf '  \033[7m ▸ [%s] %s\033[0m\n' "$_f" "$_c"
                else printf '    [%s] %s\n' "$_f" "$_c"; fi
                _n=$((_n + 1))
            done
            [ "${#_m[@]}" -gt "$_ui_rows" ] && printf '  \033[2m(%d/%d · ↑↓ scrolls)\033[0m\n' "$((_sel + 1))" "${#_m[@]}"
        fi
        printf '\n  \033[2m↑↓ move · space toggle · type filter · ⏎ done · esc cancel\033[0m'
        IFS= read -rsn1 _k || { printf '\n'; _PICKS=(); return 1; }
        case "$_k" in
        '') _PICKS=("${_picked[@]}"); printf '\n'; return 0 ;;  # empty allowed: caller decides (anynet skips; topos abort)
        ' ') if [ "${#_m[@]}" -gt 0 ]; then
                _c="${_m[$_sel]}"; _f=0; _np=()
                for _x in "${_picked[@]}"; do
                    if [ "$_x" = "$_c" ]; then _f=1; else _np+=("$_x"); fi
                done
                [ "$_f" -eq 0 ] && _np+=("$_c")
                _picked=("${_np[@]}")
                _sel=$((_sel + 1)); [ "$_sel" -ge "${#_m[@]}" ] && _sel=0
             fi ;;
        $'\x7f'|$'\b') _q="${_q%?}"; _sel=0 ;;
        $'\x1b') if IFS= read -rsn2 -t 0.05 _k2; then
                case "$_k2" in
                '[A') _sel=$((_sel - 1)); [ "$_sel" -lt 0 ] && _sel=$((${#_m[@]} - 1)) ;;
                '[B') _sel=$((_sel + 1)); [ "$_sel" -ge "${#_m[@]}" ] && _sel=0 ;;
                esac
            else printf '\n'; _PICKS=(); return 1; fi ;;
        $'\x03'|$'\x04') printf '\n'; _PICKS=(); return 1 ;;
        *) case "$_k" in [![:cntrl:]]) _q="$_q$_k"; _sel=0 ;; esac ;;
        esac
    done
}

_read_def() { # _read_def label default -> $_VAL (empty keeps default)
    printf '  %s [%s]: ' "$1" "$2"
    IFS= read -r _VAL || _VAL=""
    # esc/arrows in a typed line insert raw escape bytes — never legitimate
    # input here. Strip them so esc degrades to empty (= default/skip logic)
    # instead of smuggling "^[OA" into names, paths and numbers.
    _VAL=$(printf '%s' "$_VAL" | sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/\x1b//g')
    [ -z "$_VAL" ] && _VAL="$2"
    return 0  # set -e: typed values must not kill the caller
}

_pick_def() { # _pick_def label default items... -> $_PICK (typed input allowed)
    # A picker with options — typed input is the fallback, not the only path.
    # Wrapper over _ui_pick: same contract, sane when the list is empty.
    if [ "$#" -le 2 ]; then
        _read_def "$1" "$2"
        return 0
    fi
    local _label="$1" _def="$2"; shift 2
    if _ui_pick "$_label" "$_def" "$@"; then
        return 0
    fi
    _PICK=""
    return 1
}

_pick_num() { # _pick_num label default items... -> $_PICK
    # Numeric knob with suggested values; 'other' falls through to typing.
    if [ "$#" -gt 2 ]; then
        if _pick_def "$@"; then
            case "$_PICK" in ''|*[!0-9.]*) _read_def "$1 (typed)" "${_PICK:-$2}" ;; esac
            return 0
        fi
        return 1
    fi
    _read_def "$1" "$2"
}

_confirm_run() { # default-yes run confirmation for multi-minute builders
    _ui_pick "run it?" "yes" yes no || return 1
    [ "$_PICK" = "yes" ]
}

_cfg_list() { # -> _cfgs array: sim-config dirs only (have topology_sweep.json)
    # CONFIG drives results/$_CONFIG/topology_sweep.json (sim/plot flows).
    # The per-command results layout also creates evaluate/, evaluate-astra/,
    # topology-diff/ etc — those are COMMAND outputs, not sim configs, and
    # listing them made 5 of 8 picker options dead ends (2026-09-16).
    _cfgs=()
    local _d
    for _d in "$T3_DIR/results"/*/; do
        [ -f "$_d/topology_sweep.json" ] && _cfgs+=("$(basename "$_d")")
    done
    [ ${#_cfgs[@]} -eq 0 ] && _cfgs=("baseline")
    return 0  # set -e: callers use this bare; never fail
}

_trace_list() { # -> _traces array + _TRACE_DEF (largest trace = default)
    # ONE trace home: dse/archive/inputs/traces (symlinked from
    # dse/inputs/traces and runs/traces for legacy consumers). Listing all
    # three paths showed every trace 2-3x and offered a results/scratch
    # default that the clean-state purge deleted (2026-09-16).
    _traces=(); _TRACE_DEF=""; local _best_sz=0
    local _d _f _sz
    for _d in "$T3_DIR"/dse/archive/inputs/traces/*.trace; do
        [ -f "$_d" ] || continue
        _f="${_d#"$T3_DIR"/}"
        _traces+=("$_f")
        _sz=$(stat -c%s "$_d" 2>/dev/null || echo 0)
        (( _sz > _best_sz )) && { _best_sz=$_sz; _TRACE_DEF="$_f"; }
    done
    [ -z "$_TRACE_DEF" ] && _TRACE_DEF="${_traces[0]}"
    [ ${#_traces[@]} -eq 0 ] && { _traces=("dse/archive/inputs/traces/test_dynamic.trace"); _TRACE_DEF="${_traces[0]}"; }
    return 0
}

_anynet_list() { # -> _anynets array: .anynet files, T3_DIR-relative
    # Two kinds, two homes (was five scattered dirs — unified 2026-09-16):
    #   REFERENCES (checked-in): dse/archive/inputs, scripts/rtlgen
    #   WINNERS (synthesis):     runs/booksim = SYNTH_DIR, the one writer
    #       (bo_synthesizer._canonical_runs); dse/runs/booksim and
    #       runs/experiments are pre-refactor strays, migrated to
    #       archive/, no longer scanned. Repo-root runs/booksim still
    #       scanned as a legacy second home (pickers' historical habit).
    _anynets=()
    local _d _f _h _seen=" "
    for _d in "$T3_DIR"/dse/archive/inputs "$T3_DIR"/scripts/rtlgen \
              "$T3_DIR"/runs/booksim "$REPO_ROOT"/runs/booksim; do
        [ -d "$_d" ] || continue
        for _f in "$_d"/*.anynet; do
            [ -f "$_f" ] || continue
            _h=$(md5sum "$_f" 2>/dev/null | cut -d' ' -f1)
            case "$_seen" in *" $_h "*) continue ;; esac
            [ -n "$_h" ] && _seen="$_seen$_h "
            _anynets+=("${_f#"$T3_DIR"/}")
        done
    done
    return 0
}

_model_list() { # -> _models array + _MODEL_DEF: TrafficModel JSONs veritx run accepts
    # models/ only: examples/ are CompileRequests (different schema, used by
    # veritx compile / generate uvm) — offering them to `veritx run --model`
    # produced KeyError('network') three layers into the pipeline.
    _models=(); _MODEL_DEF="dse/models/traffic_model.json"
    local _d _f
    for _d in "$T3_DIR"/dse/models; do
        [ -d "$_d" ] || continue
        for _f in "$_d"/*.json; do
            [ -f "$_f" ] || continue
            _f="${_f#"$T3_DIR"/}"
            [[ "$_f" == *_template.json || "$_f" == README.md ]] && continue
            _models+=("$_f")
        done
    done
    return 0
}

_viz_list_pngs() { # -> _pngs array, newest first
    _pngs=()
    local _f
    while IFS= read -r _f; do _pngs+=("$_f"); done < \
        <(find "$T3_DIR/results" "$T3_DIR/runs" -name '*.png' -type f -print0 2>/dev/null | xargs -0 -r ls -t 2>/dev/null)
    return 0
}

_open_png() { # best-effort image open; always prints the path (+host path in-container)
    if command -v xdg-open >/dev/null 2>&1; then
        nohup xdg-open "$1" >/dev/null 2>&1 &
        _ok "opening → $1"
    else
        echo "  → open: $1"
    fi
    # In-container there is no image viewer and no browser: the repo is a
    # host bind-mount at /workspace, so print the host-side path — directly
    # openable, no folder-diving to translate it.
    if [ "${IN_CONTAINER:-0}" -eq 1 ] && [ -n "${T3_HOST_ROOT:-}" ]; then
        case "$1" in
        /workspace/*) echo "  host open: ${T3_HOST_ROOT}${1#/workspace}" ;;
        esac
    fi
}

# --- cross-session state (gitignored: results/.t3_state) --------------------
T3_STATE="${T3_STATE:-$T3_DIR/results/.t3_state}"
_state_load() {
    [ -f "$T3_STATE" ] || return 0
    local _k _v
    while IFS='=' read -r _k _v; do
        case "$_k" in
        # env explicitly set by the caller wins over persisted state; stock
        # defaults (CONFIG=baseline, the default RATES) count as "unset".
        CONFIG) if { [ -z "${CONFIG:-}" ] || [ "${CONFIG:-}" = "baseline" ]; } && [ -n "$_v" ]; then export CONFIG="$_v"; fi ;;
        MODEL)  if [ -z "${MODEL:-}" ] && [ -n "$_v" ]; then export MODEL="$_v"; fi ;;
        TOPO)   if [ -z "${TOPO:-}" ] && [ -n "$_v" ]; then export TOPO="$_v"; fi ;;
        RATES)  if { [ -z "${RATES:-}" ] || [ "${RATES:-}" = "0.002,0.005,0.01,0.02,0.03" ]; } && [ -n "$_v" ]; then export RATES="$_v"; fi ;;
        SIZES)  if [ -z "${SIZES:-}" ] && [ -n "$_v" ]; then export SIZES="$_v"; fi ;;
        esac
    done < "$T3_STATE"
}
_state_set() { # persist CONFIG/MODEL/TOPO/RATES/SIZES for the next t3 session
    mkdir -p "$(dirname "$T3_STATE")" 2>/dev/null || true
    local _tmp="$T3_STATE.tmp"
    { printf 'CONFIG=%s\n' "${CONFIG:-baseline}"
      printf 'MODEL=%s\n' "${MODEL:-}"
      printf 'TOPO=%s\n' "${TOPO:-}"
      printf 'RATES=%s\n' "${RATES:-}"
      printf 'SIZES=%s\n' "${SIZES:-}"; } > "$_tmp" 2>/dev/null \
        && mv "$_tmp" "$T3_STATE" 2>/dev/null || true
}
_state_load
_T3_FIRST_RUN=0
[ ! -f "$T3_STATE" ] && _T3_FIRST_RUN=1
trap '_ui_leave' EXIT   # dispatch-level safety: never leave the alt screen up

# --- knob resolution (one path for every command) ---------------------------
_knob_spec() { # knobs a command takes (env it actually reads)
    case "$1" in
    sim) echo "RATES CONFIG" ;;
    astrasim) echo "MODEL TOPO CONFIG SIZES" ;;
    timeloop-workload|timeloop-spatial|report|energy|analysis|aggregate|plot|dashboard) echo "CONFIG" ;;
    *) echo "" ;;
    esac
}
_knob_pick() { # fuzzy-pick one knob value into its var; rc=1 = cancel
    case "$1" in
    RATES) _ui_pick "rates (injection)" "${RATES:-0.002,0.005,0.01,0.02,0.03}" \
               "0.002,0.005,0.01,0.02,0.03" "0.01,0.02,0.05" "0.005" "0.01" "0.02" "0.03" || return 1
           export RATES="$_PICK"; _state_set ;;
    MODEL) # registry-driven: builtins are seeded on first use, customs via t3 model-add
           local _models=()
           _models=("$T3_PYTHON" "$T3_SCRIPTS/lib/t3models.py" list_names)
           _models=("$("${_models[@]}" 2>/dev/null)")
           [ -z "${_models:-}" ] && _models="llama7b llama70b all_reduce gpt3 resnet50"
           _ui_pick "model (workload)" "${MODEL:-all_reduce}" $_models || return 1
           export MODEL="$_PICK"; _state_set ;;
    TOPO) _ui_pick "topo (substring, all=all)" "${TOPO:-all}" \
               all anynet16 cmesh16 dragonfly16 fattree16 flatfly16 fly4 ftree mesh4x4 qtree16 torus4x4 tree4 cmesh64 fattree64 flatfly64 fly64 mesh8x8 qtree64 torus8x8 tree4_64 || return 1
          export TOPO="$_PICK"; [ "$TOPO" = "all" ] && TOPO=""; _state_set ;;
    SIZES) _ui_pick "topo size family" "${SIZES:-auto}" auto n16 n64 legacy || return 1
          export SIZES="$_PICK"; _state_set ;;
    CONFIG) _cfg_list
           _ui_pick "config (results dir)" "${CONFIG:-baseline}" "${_cfgs[@]}" || return 1
           export CONFIG="$_PICK"; _state_set ;;
    esac
    return 0
}
_menu_run() { # _menu_run cmd [args]: resolve knobs, then hand to the runner
    _run_cmd "$@" || return 1
    _ui_open
}
_run_cmd() { # ONE path for every command: prompt knobs, stage command array
    local _c="$1"; shift || true
    local _kn
    # shellcheck disable=SC2046
    for _kn in $(_knob_spec "$_c"); do
        case " ${_EXPLICIT:-} " in *" $_kn "*) continue;; esac
        _knob_pick "$_kn" || { _EXPLICIT=""; return 1; }
    done
    if [ "$_c" = "astrasim" ]; then
        case " ${_EXPLICIT:-} " in *" CONFIG "*);; *)
            if [ -n "${TOPO:-}" ] && [ "${CONFIG:-baseline}" = "baseline" ]; then
                CONFIG="scratch"; export CONFIG
            fi;;
        esac
    fi
    # T3_RESULTS re-derive lives in _dispatch (covers every path, including
    # start-here steps that bypass this prompter).
    _EXPLICIT=""
    _RUN_NAME="$_c"
    [ $# -gt 0 ] && _RUN_NAME="$_c $*"
    _RUN=(_dispatch "$_c" "$@")
}

_run_line() { # run a typed line: VAR=val prefixes, then dispatch
    set -- $1   # word-split intentional
    [ $# -eq 0 ] && return 0
    _EXPLICIT=""
    while [ $# -gt 0 ]; do
        case "$1" in
        *=*) _EXPLICIT="$_EXPLICIT ${1%%=*}"; export "$1"; shift ;;
        *) break ;;
        esac
    done
    [ $# -eq 0 ] && return 0
    case "$1" in
    menu) return 0 ;;  # already in the menu
    clean) _ui_pick "clean - permanently delete results/ ?" "no" \
               "no" "yes, delete results/" || return 0
           case "$_PICK" in
           yes*) _RUN_NAME="clean"; _RUN=(_dispatch clean --force); _ui_open ;;
           esac ;;
    veritx) _run_veritx_menu "$@" ;;        shell|bash) _RUN_NAME="container shell"; _RUN=(cmd_exec bash); _ui_open ;;
    *)
        # Phase 3a: allowlist derived from _T3_NATIVE (single source), not a
        # second hardcoded list. `veritx`/`shell`/`menu`/`clean` handled above.
        case " ${_T3_NATIVE} " in
        *" $1 "*) _menu_run "$@" || true ;;
        *) _RUN_NAME="$*"; _RUN=("$@"); _ui_open ;;  # raw executable: no knobs to prompt
        esac
        ;;
    esac
    return 0
}

_run_veritx_menu() { # bare verbs needing args open their builder, not an error
    if [ $# -eq 2 ]; then
        case "$2" in
        compare) cmd_veritx_compare || true ;;
        compile) cmd_veritx_compile || true ;;
        sweep) cmd_veritx_sweep || true ;;
        pareto) cmd_veritx_pareto || true ;;
        baseline) cmd_veritx_baseline || true ;;
        run) cmd_veritx_run || true ;;
        report) cmd_veritx_report || true ;;
        where) cmd_veritx_where || true ;;
        serve) cmd_veritx_serve || true ;;
        trace) _veritx_sub trace chakra model hpc slice info extract validate || true ;;
        synthesize) _veritx_sub synthesize bo iterative || true ;;
        evaluate) _veritx_sub evaluate booksim anynet astra || true ;;
        certify) _veritx_sub certify flow rtl full || true ;;
        generate) _veritx_sub generate uvm || true ;;
        *) _menu_run "$@" || true ;;
        esac
    else
        _menu_run "$@" || true
    fi
}

_ui_runner() { # type to filter any t3 command; optional seed as $1
    # Phase 3a: both lists sourced, not hardcoded twice. _cmds is the single
    # _T3_NATIVE source (+ shell for the container-shell shortcut, which is a
    # _run_line menu shortcut, not a _dispatch command). _vsubs is live from
    # `veritx --list-commands` via _veritx_verbs() (fallback verified by
    # `t3 selfcheck`).
    local _cmds="$_T3_NATIVE shell"
    local _vsubs
    _vsubs=$(_veritx_verbs)
    local _q="${1:-}" _sel=0 _m=() _c _k _k2 _i _n _line _vr
    while true; do
        _m=()
        if [[ "$_q" == veritx\ * ]] && [[ "$_q" != veritx\ *\ * ]]; then
            _vr="${_q#veritx }"  # completing the subcommand: all verbs
            for _c in $_vsubs; do
                case "$_c" in *"$_vr"*) _m+=("veritx $_c");; esac
            done
        elif [[ "$_q" == veritx\ * ]]; then
            :  # typing args: nothing to complete, enter runs
        else
            for _c in $_cmds; do
                case "$_c" in *"${_q%% *}"*) _m+=("$_c");; esac
            done
        fi
        [ "$_sel" -ge "${#_m[@]}" ] && _sel=0
        _ui_clear
        printf '  \033[1mt3 › run\033[0m  \033[2mtype to filter — ⏎ runs the highlighted command\033[0m\n'
        printf '  ────────────────────────────────────────────────────────────\n'
        printf '  › %s\n\n' "$_q"
        if [ "${#_m[@]}" -eq 0 ]; then
            printf '  \033[2mno match — ⏎ runs what you typed, esc cancels\033[0m\n'
        else
            _n=0
            for _c in "${_m[@]:0:10}"; do
                if [ "$_n" -eq "$_sel" ]; then printf '  \033[7m ▸ %s\033[0m\n' "$_c"
                else printf '    %s\n' "$_c"; fi
                _n=$((_n + 1))
            done
        fi
        printf '\n  \033[2m↑↓ move · ⏎ run · tab complete · esc cancel\033[0m'
        IFS= read -rsn1 _k || { printf '\n'; break; }
        case "$_k" in
        '') if [[ "$_q" == veritx\ * ]] && [[ "$_q" != veritx\ *\ * ]] && [ "${#_m[@]}" -gt 0 ]; then
                _q="${_m[$_sel]} "; _sel=0; continue  # finish the verb first, args next
            fi
            if [[ "$_q" == *[\ =]* ]]; then _line="$_q"
            elif [ "${#_m[@]}" -gt 0 ]; then _line="${_m[$_sel]}"
            elif [ -n "$_q" ]; then _line="$_q"
            else printf '\n'; break; fi
            printf '\n'
            _run_line "$_line"
            return 0 ;;
        $'\x7f'|$'\b') _q="${_q%?}"; _sel=0 ;;
        $'\x1b') if IFS= read -rsn2 -t 0.05 _k2; then
                case "$_k2" in
                '[A') _sel=$((_sel - 1)); [ "$_sel" -lt 0 ] && _sel=$((${#_m[@]} - 1)) ;;
                '[B') _sel=$((_sel + 1)); [ "$_sel" -ge "${#_m[@]}" ] && _sel=0 ;;
                esac
            else
                printf '\n'
                return 1  # bare esc cancels
            fi ;;
        $'\t') [ "${#_m[@]}" -gt 0 ] && { _q="${_m[$_sel]} "; _sel=0; } ;;
        $'\x03'|$'\x04') printf '\n'; return 1 ;;
        *) case "$_k" in [![:cntrl:]]) _q="$_q$_k"; _sel=0 ;; esac ;;
        esac
    done
    return 1
}

# --- guided builders: visualization & comparison ----------------------------
# shellcheck disable=SC2016
_trace_topo_list() { # -> _topos_all: newline list of topologies in a sweep JSON
    "$T3_PYTHON" - "$1" <<'PYEOF'
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
    print("\n".join(sorted({r["topology"] for r in rows if isinstance(r, dict) and r.get("topology")})))
except Exception:
    pass
PYEOF
}

cmd_plot_config() { # guided: config + style + optional topo focus → curves PNG
