                   "menu_run:model" "menu_run:model-add" "menu_run:logs" \
                   "menu_run:env" "menu_run:selfcheck" "menu_run:lint" \
                   "clean" "webui" "page:main")
            ;;
        esac
    }
    _page_title() {
        case "${_pages[_pidx]}" in
        main)    printf 'control room' ;;
        sweeps)  printf 'sweeps · simulations' ;;
        compare) printf 'compare · n-way' ;;
        viz)     printf 'visualize' ;;
        veritx)  printf 'veritx · DSE CLI' ;;
        cfg)     printf 'configure' ;;
        esac
    }
    _menu_draw() {
        local _t; _t=$(_page_title)
        printf '  \033[1;36mt3\033[0m\033[2m · %s\033[0m\033[2m   (←→/h-l pages)\033[0m\n' "$_t"
        printf '  \033[2mCONFIG=%s  MODEL=%s  TOPO=%s\033[0m\n' \
            "${CONFIG:-baseline}" "${MODEL:-all_reduce}" "${TOPO:-all}"
        if [ "${_T3_FIRST_RUN:-0}" -eq 1 ] && [ "${_pages[_pidx]}" = "main" ]; then
            printf '  \033[2mfirst time? pick \"start here\", press ⏎, and just follow the steps\033[0m\n'
        fi
        printf '\n'
        local _i=0
        for _o in "${_opts[@]}"; do
            _i=$((_i + 1))
            if [ $((_i - 1)) -eq "$_hi" ]; then
                printf '  \033[7m %2d) %-46s \033[0m\n' "$_i" "$_o"
            else
                printf '   %2d) %-46s\n' "$_i" "$_o"
            fi
        done
        printf '\n'
        local _pn _pbadges=""
        for _pn in "${_pages[@]}"; do
            if [ "$_pn" = "${_pages[_pidx]}" ]; then
                _pbadges+="\033[7m $_pn \033[0m "
            else
                _pbadges+="\033[2m $_pn \033[0m "
            fi
        done
        printf '  %b\n' "$_pbadges"
    }
    _act() { # execute a page action
        local _a="$1"
        case "$_a" in
        menu_run:veritx\ *) _EXPLICIT=""; _run_veritx_menu ${_a#menu_run:} || true ;;  # builder-aware
        menu_run:*) _EXPLICIT=""; _menu_run ${_a#menu_run:} || true ;;  # unquoted: word split
        page:*) _pidx=0; _hi=0
                local _p; for _p in "${!_pages[@]}"; do
                    [ "${_pages[$_p]}" = "${_a#page:}" ] && _pidx=$_p
                done ;;
        knob:*) _knob_pick "${_a#knob:}" || true; _state_set ;;
        start_here) cmd_start_here ;;
        full_astrasim) export MODEL=all_reduce TOPO=""; _state_set; _EXPLICIT=" MODEL TOPO"; _menu_run astrasim || true ;;
        quick_compare) cmd_quick_compare ;;
        veritx_compare) cmd_veritx_compare ;;
        veritx_compile) cmd_veritx_compile ;;
        veritx_serve) cmd_veritx_serve ;;
        plot_config) cmd_plot_config ;;
        overlay) cmd_compare_curves ;;
        bars) cmd_compare_bars ;;
        heat) cmd_compare_heat ;;
        open_png) cmd_viz_open ;;
        shell) _RUN_NAME="container shell"; _RUN=(cmd_exec bash); _ui_open ;;
        runner) _ui_runner || true ;;
        clean) _ui_pick "clean - permanently delete results/ ?" "no" \
                   "no" "yes, delete results/" || return 0
               case "$_PICK" in
               yes*) _RUN_NAME="clean"; _RUN=(_dispatch clean --force); _ui_open ;;
               esac ;;
        webui) _RUN_NAME="web ui"; _RUN=(_dispatch webui --no-open); _ui_open ;;
        quit) return 2 ;;
        esac
        return 0
    }
    _hi=0
    _ui_enter
    trap '_ui_leave' EXIT INT TERM
    while true; do
        _num=""
        _need_draw=1
        while true; do
            if [ "$_need_draw" -eq 1 ]; then
                _page_items
                [ "$_hi" -ge "${#_opts[@]}" ] && _hi=0
                _ui_clear
                _menu_draw
                _need_draw=0
            else
                printf '\r\033[K'  # wipe status line, redraw in place
            fi
            printf '  \033[7m ⏎ run \033[0m \033[7m %-11s \033[0m \033[2m·\033[0m \033[7m q quit \033[0m \033[2m· ↑↓ move · ←→ page · number · type to filter: %s\033[0m' \
                "${_opts[$_hi]%%:*}" "$_num"
            IFS= read -rsn1 _k || break 2
            case "$_k" in
            [0-9]) _num="$_num$_k"; [ "${#_num}" -gt 2 ] && _num="$_k" ;;  # in-place, no flicker
            $'\x1b') if IFS= read -rsn2 -t 0.05 _k2; then
                    _num=""
                    _need_draw=1
                    _last=${#_opts[@]}
                    _last=$((_last - 1))
                    case "$_k2" in
                    '[A') _hi=$((_hi - 1)); [ "$_hi" -lt 0 ] && _hi=$_last ;;
                    '[B') _hi=$((_hi + 1)); [ "$_hi" -gt "$_last" ] && _hi=0 ;;
                    '[C') _pidx=$((_pidx + 1)); [ "$_pidx" -ge "${#_pages[@]}" ] && _pidx=0
                          _hi=0 ;;
                    '[D') _pidx=$((_pidx - 1)); [ "$_pidx" -lt 0 ] && _pidx=$((${#_pages[@]} - 1))
                          _hi=0 ;;
                    esac
                else
                    break 2  # bare esc quits
                fi ;;
            '') if [ -n "$_num" ]; then _sel="$_num"; else _sel=$((_hi + 1)); fi
                if [ "$_sel" -ge 1 ] && [ "$_sel" -le "${#_opts[@]}" ]; then
                    _hi=$((_sel - 1))
                    _rc=0
                    _act "${_acts[$_hi]}" || _rc=$?   # '||' guards rc=2 (quit) from set -e
                    [ "$_rc" -eq 2 ] && break 2
                else
                    printf '\a'; _num=""; sleep 0.4
                fi
                _need_draw=1
                break ;;  # outer loop resets _num and redraws
            q|Q) break 2 ;;
            h|l) _num=""; _need_draw=1
                 case "$_k" in
                 l) _pidx=$((_pidx + 1)); [ "$_pidx" -ge "${#_pages[@]}" ] && _pidx=0 ;;
                 h) _pidx=$((_pidx - 1)); [ "$_pidx" -lt 0 ] && _pidx=$((${#_pages[@]} - 1)) ;;
                 esac
                 _hi=0 ;;
            *) _ui_runner "$_k" || true ; _need_draw=1 ; break ;;
            esac
        done
    done
    _ui_leave
    trap - EXIT INT TERM
    _state_set
    echo "  bye."
}
