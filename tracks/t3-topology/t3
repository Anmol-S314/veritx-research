cmd_start_here() { # guided end-to-end run for first-time / non-dev users
    _ui_pick "start here — what do you want to do?" "full walkthrough" \
        "full walkthrough — sim → compare → report → open plots" \
        "compare topologies on real traffic (quick compare)" \
