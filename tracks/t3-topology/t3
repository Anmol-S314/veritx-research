  ══════════════════════════════════════════════════════════════════
EOF
}

cmd_help_topic() {
    case "$1" in
    sim)
        cat <<'EOF'
  t3 sim — uniform-traffic BookSim sweep over configs/*.cfg
  Usage:  [CONFIG=baseline] [RATES=0.002,0.005,0.01,0.02,0.03] t3 sim
            [TRAFFIC_MATRIX=path/matrix.txt] t3 sim   (matrix-driven instead of uniform)
  Output: results/<CONFIG>/topology_sweep.json  (55 rows: 11 topos × 5 rates)
  Needs:  container booksim (t3 check shows it) — host-built binaries die on old glibc.
  Time:   ~5 min. Takes NO flags; RATES/CONFIG are env-only.
  Ex:     t3 sim
            RATES=0.01,0.02,0.05 t3 sim
EOF
        ;;
    astrasim)
        cat <<'EOF'
  t3 astrasim — ASTRA-Sim chakra sweep, one run per topology (8 cfgs per size family)
  Usage:  [CONFIG=baseline] [MODEL=llama7b] [TOPO=<substr>] [SIZES=n64] t3 astrasim
  Models: llama7b (32 layers, ~2-20 min/topo), llama70b (hours), all_reduce (~2 min/topo)
  Sizes:  SIZES=n64|n16|legacy (default auto: CONFIG suffix decides); menu offers a picker.
  sizing: MODEL_TP=8 MODEL_SEQ=2048 … (or --tp 8 --seq-len 2048 flags) override the workload shape.
  TOPO filters by substring: TOPO=mesh4x4 runs one topo (2-min canary).
  Output: results/<CONFIG>/astrasim_sweep.json  (merges into topology_sweep.json;
           ok rows resume-skip on retry, failed rows never clobber good data)
  Needs:  host-native AstraSim_BookSim2 (auto-detected; container's is too old).
  Ex:     MODEL=all_reduce TOPO=mesh4x4 t3 astrasim
            MODEL=all_reduce t3 astrasim           # full 8-topo microbench sweep
EOF
        ;;
    timeloop|timeloop-workload|timeloop-spatial)
        cat <<'EOF'
  t3 timeloop* — Timeloop/Accelergy energy spine (slow: hours)
  Usage:  [CONFIG=baseline] t3 timeloop[-workload|-spatial]
  Needs:  timeloop-mapper + accelergy in container (t3 check).
  Start small: run `t3 energy` first only AFTER timeloop stats exist.
EOF
        ;;
    analysis|aggregate|plot)
        cat <<'EOF'
  t3 analysis — sweep JSON -> console table.   Ex: t3 analysis
  t3 aggregate — merge sweep+history -> results/<CONFIG>/analysis/aggregate.csv
  t3 plot — latency curves -> .../analysis/latency_curves.png  (try: t3 plot --hops)
EOF
        ;;
    report)
        cat <<'EOF'
  t3 report — full report via make (analysis + aggregate + plot).
  Usage:  [CONFIG=baseline] t3 report
EOF
        ;;
    energy)
        cat <<'EOF'
  t3 energy — NoC/workload energy breakdown from timeloop stats.
  Needs:  a timeloop.stats.txt with "Summary Stats" (run t3 timeloop first).
  It searches: timeloop/timeloop-mapper.stats.txt, <results>/timeloop.stats.txt,
  results/timeloop.stats.txt, results/<CONFIG>/timeloop.stats.txt.
  Without stats it fails honestly — that means run the timeloop leg first.
EOF
        ;;
    dashboard)
        cat <<'EOF'
  t3 dashboard — Plotly dashboard from results.  Ex: t3 dashboard
EOF
        ;;
    check|env)
        cat <<'EOF'
  t3 check — toolchain: python, pandas, matplotlib, booksim, timeloop-mapper,
  astrasim frontend (repo-built path), accelergy, sweep JSON presence.
  t3 env — print the active env vars above.
EOF
        ;;
    exec|shell|run|bash)
        cat <<'EOF'
  t3 exec <cmd> — run anything inside the container. Ex: t3 exec booksim --help
  t3 shell — interactive container shell (bind-mounts the repo at /workspace).
EOF
        ;;
    selfcheck|lint|clean)
        cat <<'EOF'
  t3 selfcheck — embedded unit checks for analysis/aggregate/plot_curves.
  t3 lint — py_compile every script.  t3 clean — rm -rf results/ + __pycache__ (asks first; --force skips).
EOF
        ;;
    veritx)
        cat <<'EOF'
  t3 veritx — VeritX DSE CLI inside the container (booksim backend).
  Runs: PYTHONPATH=dse python3 -m veritx_dse.cli (py3.10-compatible).
  Ex:     t3 veritx where
            t3 veritx compare --trace results/scratch/qwen3_20k.trace --topos mesh_8x8,torus_8x8 --seeds 1 --mode throughput --timeout 120
            t3 veritx sweep --trace <trace> --timeout 120
  NOTE: full 11 MB qwen3 trace needs slicing first (menu: compare → quick compare slices it, or veritx trace slice).   Bare verbs open a guided builder: compare/sweep/pareto/baseline/run/report/
   where/compile pickers, trace→make/inspect subverb+args,
   synthesize/evaluate/certify subverb+args.
   diff/runs/results/history/status/init run as-is. serve runs as-is too but
   blocks (it's a server) and needs --cluster-config + --dataset.
   ASTRA evaluate needs the host frontend — use native veritx for that.
EOF
        ;;
    menu)
        cat <<'EOF'
  t3 menu — numbered walkthrough (check → sim → report). Same flows, no memorization.
EOF
        ;;
    model|model-add|logs|logs-prune)
        cat <<'EOF'
  t3 model        — list the workload registry (models + collectives)
  t3 model-add    — guided: define a workload → workloads/<name>.json
                    (becomes MODEL=<name> in pickers, webui, and sweeps)
  t3 logs         — recent sweep sessions; pick one to see its event stream
  t3 logs-prune   — delete session logs older than N days (asks)
  Registry files are plain JSON — drop one in workloads/ and it just appears.
EOF
        ;;
    *)
        echo "  [t3] No help for '$1'. Topics: sim astrasim timeloop analysis aggregate plot report energy dashboard check exec selfcheck veritx menu"
        return 1
        ;;
    esac
}

