            ;;
        viz)
            _opts=("latency curves: CONFIG=${CONFIG:-baseline} → PNG" \
                   "latency curves + hops axis" \
                   "configure & plot: pick config + style" \
                   "n-way overlay: sweep curves across configs" \
                   "compare bars: veritx results chart" \
                   "win/loss heatmap: across all compare results" \
                   "plotly dashboard (HTML)" \
                   "open latest PNG" \
