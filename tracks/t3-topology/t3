# Web UI: zero-install browser control room over the same commands.
# --webcmd restricts routing to a small allowlist (the web server can only
# ever execute one of these — never raw user text).
# Phase 3a: intentionally EXPLICIT (not auto-derived from _T3_NATIVE) — the
# web surface must stay a strict subset (no clean/exec/menu/webui). Underscore
# names map to dash commands (compare_curves→compare-curves). `t3 selfcheck`
# verifies every entry resolves into _T3_NATIVE and fails loudly on drift.
_WEBCMDS=(check sim astrasim report analysis aggregate \
          compare_curves compare_bars compare_heat quick_compare selfcheck lint \
          model model_add logs)
cmd_webui() {
    if [ "${1:-}" = "--webcmd" ]; then
        local _w="${2:-}"
        case " ${_WEBCMDS[*]} " in
        *" $_w "*)
            _banner "t3 ${_w//_/ }"
            "cmd_${_w}" || return $?  # cmd_check, cmd_sim, cmd_compare_heat …
            ;;
        *)
            echo "  [webui] unknown --webcmd: $_w"
            return 1
            ;;
        esac
        return 0
    fi
    _banner "Web UI"
    # In-container the host browser needs bridge access (see T3_WEBUI_PUBLIC).
    # -u: unbuffered so the menu runner streams server output live.
    if [ "${IN_CONTAINER:-0}" -eq 1 ]; then
        export T3_WEBUI_PUBLIC=1
        if [ "${T3_PORT_PUBLISHED:-1}" != "1" ]; then
            echo "  host :8517 is busy (own server already running?)."
            echo "  Open http://localhost:8517 directly — not starting a twin."
            return 0
        fi
    fi
    ( cd "$T3_DIR" && "$T3_PYTHON" -u scripts/t3_web.py "$@" )
}

# All command routing lives here so the menu's `t3>` prompt can reuse it.
# Defined BEFORE the TTY->menu branch: bare `t3` runs its whole session
# before execution reaches the bottom of this file.
# Phase 3a: generic registry-driven forwarder. Native t3-only commands resolve
# via _T3_NATIVE (single source) to cmd_* functions with "$@" ALWAYS forwarded
# (this collapse also fixes the old per-case "$@" drops for timeloop/report/
# energy/etc.). `veritx` forwards via cmd_veritx (`veritx "$cmd" "$@"`).
# Blocked veritx subpaths in _T3_BLOCKED are refused loudly with their reason.
_dispatch() {
    local _cmd="${1:-help}"
    shift || true
    # Re-derive T3_RESULTS from CONFIG on EVERY dispatch (not just the menu
    # path): start-here steps, the runner, and veritx passthroughs all land
    # here, and a stale T3_RESULTS once sent compare output to results/baseline
    # while CONFIG pointed elsewhere — then report crashed on the missing file.
    # EXCEPT when the user forwarded an explicit T3_RESULTS into the container
    # (T3_RESULTS_EXPLICIT=1 from _forward_path): their value must win.
    if [ "${T3_RESULTS_EXPLICIT:-}" != "1" ] && { [ -z "${T3_RESULTS:-}" ] || [ "${T3_RESULTS_FOR:-}" != "${CONFIG:-baseline}" ]; }; then
        export T3_RESULTS="$T3_DIR/results/${CONFIG:-baseline}"
        export T3_RESULTS_FOR="${CONFIG:-baseline}"
    fi
    export T3_OUTPUT="$T3_RESULTS/analysis"
    case "$_cmd" in
    help|-h|--help) cmd_help "$@" ;;
    --webcmd) cmd_webui --webcmd "$@" ;;
    *)
        # Blocklist: veritx subpaths only (e.g. evaluate/astra). Empty today —
        # see _T3_BLOCKED reason comments. Check `veritx <a> <b>` shape.
        if [ "$_cmd" = "veritx" ] && [ -n "$_T3_BLOCKED" ]; then
            local _vp="${1:-}${2:+/$2}"
            local _b
            for _b in $_T3_BLOCKED; do
                if [ "$_vp" = "$_b" ]; then
                    echo "  [t3] blocked: veritx ${_b//\// } (see _T3_BLOCKED reason)" >&2
                    return 1
                fi
            done
        fi
        # Native t3 commands (ONE list: _T3_NATIVE). Aliases mapped; all get "$@".
        case " ${_T3_NATIVE} " in
        *" $_cmd "*)
            local _fn
            case "$_cmd" in
            pa-report) _fn=cmd_report ;;
            exec|run) _fn=cmd_exec ;;
            *) _fn="cmd_${_cmd//-/_}" ;;
            esac
            if declare -F "$_fn" >/dev/null; then
                "$_fn" "$@"
                return $?
            fi
            ;;
        esac
        # Fallback: executable on PATH (timeloop-mapper, booksim, …), else error.
        if command -v "$_cmd" &>/dev/null; then
            "$_cmd" "$@"
        else
            echo "  [t3] Unknown command or executable: '$_cmd'"
            echo "  Run 't3 help' for usage."
            return 1
        fi
        ;;
    esac
}

# Dispatch
# No args on a TTY → menu (discoverable); piped → help text (scriptable).
if [ -z "${1:-}" ] && [ -t 0 ]; then
    cmd_menu
    exit $?
fi
COMMAND="${1:-help}"
shift || true

_dispatch "$COMMAND" "$@"
