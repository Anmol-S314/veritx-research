cmd_lint() {
    _banner "Lint — syntax check"
    # Failing gate: any component failure => exit 1. Previously _warn masked
    # py_compile failures and this script itself was never linted.
    local _rc=0 _f
    for _f in "$T3_SCRIPTS"/*.py; do
        "$T3_PYTHON" -m py_compile "$_f" && _ok "$(basename "$_f")" || { _err_lint "$(basename "$_f") has errors"; _rc=1; }
    done
    bash -n "$T3_SCRIPT_PATH" && _ok "t3 (bash -n)" || { _err_lint "t3 fails bash -n"; _rc=1; }
    if command -v shellcheck >/dev/null 2>&1; then
        # shellcheck disable=SC2016
        if shellcheck -S warning "$T3_SCRIPT_PATH"; then _ok "t3 (shellcheck)"; else _err_lint "shellcheck findings above"; _rc=1; fi
    else
        _warn "shellcheck not installed — skipped"
    fi
    return $_rc
}
_err_lint() { echo "  ✗  $*" >&2; }

cmd_veritx() {
    # NOTE: environment validation (missing Python deps, stale images) is
    # owned by the CLI itself: veritx_dse.cli:main fails fast from
    # core.deps, driven by dse/pyproject.toml. No per-package checks here —
    # duplicating that list in bash is how it rotted last time.
    # A bare verb with missing required args would die on raw argparse usage.
    # Route through the builder-aware router: the menu does this for its own
    # rows, and a TTY gets the same guided picks; piped stdin keeps the
    # scriptable hint (no pickers available).
    # Re-entry guard: the router stages _RUN=(_dispatch veritx <verb>), which
    # lands RIGHT BACK HERE. Without it, bare verbs recurse forever
    # (breadcrumb+banner with no output). Detect the router in our callers.
    local _routed=0 _fr
    for _fr in "${FUNCNAME[@]}"; do
        case "$_fr" in _run_veritx_menu|_menu_run|_ui_open) _routed=1;; esac
    done
    [ $_routed -eq 0 ] && _banner "VeritX DSE"
    # Phase 3a: flags (e.g. --list-commands, --help) forward directly — only
    # bare VERBS (no dash) open the guided builder. Previously any single arg,
    # including flags, was swallowed by the builder hint.
    if [ "$#" -eq 1 ] && [ $_routed -eq 0 ]; then
        case "$1" in
        -*) ;;  # flag: fall through to direct forward below
        *)
        local _routed=0 _fr
        for _fr in "${FUNCNAME[@]}"; do
            case "$_fr" in _run_veritx_menu|_menu_run|_ui_open) _routed=1;; esac
        done
        if [ $_routed -eq 0 ]; then
            if [ ! -t 0 ]; then
                echo "  (non-interactive: 'veritx $1' needs guided picks — use 't3 menu' → veritx page)"
                return 0
            fi
            _run_veritx_menu veritx "$1"
            return 0
        fi
        ;;
        esac
    fi
    ( cd "$T3_DIR" && PYTHONPATH="$T3_DIR/dse${PYTHONPATH:+:$PYTHONPATH}" _py -m veritx_dse.cli "$@" )
}

