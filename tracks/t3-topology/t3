cmd_compare_curves() { # n-way overlay of sweep curves across configs
    local _sweeps=() _f
    for _f in "$T3_DIR"/results/*/topology_sweep.json; do
        [ -f "$_f" ] && _sweeps+=("${_f#"$T3_DIR"/}")
    done
    if [ "${#_sweeps[@]}" -eq 0 ]; then
        echo "  no sweep JSONs yet — run t3 sim first (menu: sweeps → sim)"
        return 0
    fi
    [ "${#_sweeps[@]}" -eq 1 ] && echo "  (only one sweep exists — run another CONFIG=<name> sim for a richer overlay)"
    _ui_multi "sweeps to overlay" "" "${_sweeps[@]}" || return 0
    # Headless default: overlay every sweep found (up to 8 keeps the chart legible).
    if [ ! -t 0 ] && [ "${#_PICKS[@]}" -eq 0 ]; then
        _PICKS=("${_sweeps[@]:0:8}")
    fi
    [ "${#_PICKS[@]}" -eq 0 ] && return 0
    local _args=() _p _lbl
    for _p in "${_PICKS[@]}"; do
        _lbl="$(basename "$(dirname "$_p")")"
        _args+=(--json "$_lbl:$T3_DIR/$_p")
    done
    _RUN_NAME="overlay ${#_PICKS[@]} configs"
    _RUN=("$T3_PYTHON" "$T3_SCRIPTS/compare_curves.py" "${_args[@]}" --out "$T3_DIR/results/compare_curves.png")
    _ui_open
}

_compare_results() { # -> _jsons[]: usable veritx compare JSONs, newest first
    # veritx writes under $REPO_ROOT/runs (RUNS_DIR); t3-legacy under $T3_DIR/runs;
    # baseline/compare run-dirs under $T3_DIR/results. Single-eval eval_*.json
    # files are flat dicts (no summary/results to aggregate) — not scanned, so
    # the chart never warns about them.
    _jsons=()
    local _f _seen=" "
    for _f in $(ls -t "$REPO_ROOT"/runs/booksim/compare_*.json \
                     "$T3_DIR"/runs/booksim/compare_*.json \
                     "$T3_DIR"/results/baseline/*/baseline.json \
                     "$T3_DIR"/results/compare/*/compare.json 2>/dev/null); do
        [ -f "$_f" ] || continue
        case "$_seen" in *" $_f "*) continue ;; esac
        if grep -q '"summary"[[:space:]]*:\|"results"[[:space:]]*:' "$_f" 2>/dev/null; then
            :
        elif [ "$(head -c 1 "$_f" 2>/dev/null)" = "[" ] && \
             grep -q '"latency"\|"honest_latency"' "$_f" 2>/dev/null; then
            : # bare list (sweep rows): the loader aggregates on the fly
        else
            continue
        fi
        _seen="$_seen$_f "
        _jsons+=("$_f")
    done
}

cmd_compare_bars() { # bar chart from veritx compare result JSONs (n-way)
    local _jsons=()
    _compare_results
    if [ "${#_jsons[@]}" -eq 0 ]; then
        echo "  no compare results yet — run quick compare first (menu: compare)"
        return 0
    fi
    _ui_multi "compare results to chart" "" "${_jsons[@]}" || return 0
    # Headless default: chart everything found (that's the useful n-way view).
    [ ! -t 0 ] && [ "${#_PICKS[@]}" -eq 0 ] && _PICKS=("${_jsons[@]}")
    [ "${#_PICKS[@]}" -eq 0 ] && return 0
    local _args=() _p _lbl
    for _p in "${_PICKS[@]}"; do
        _lbl="$(basename "$_p" .json)"; _lbl="${_lbl:0:14}"
        case "$_p" in
        /*) _args+=(--json "$_lbl:$_p") ;;   # already absolute
        *)  _args+=(--json "$_lbl:$T3_DIR/$_p") ;;
        esac
    done
    _RUN_NAME="compare bars"
    _RUN=("$T3_PYTHON" "$T3_SCRIPTS/compare_bars.py" "${_args[@]}" --out "$T3_DIR/runs/booksim/compare_bars.png")
    _ui_open
}

cmd_compare_heat() { # win/loss heatmap: pairwise win-share across many compare results
    local _jsons=()
    _compare_results
    if [ "${#_jsons[@]}" -lt 2 ]; then
        echo "  need ≥2 compare results — run quick compare a few times first (menu: compare)"
        return 0
    fi
    echo "  (found ${#_jsons[@]} results; picking all gives the richest matrix)"
    _ui_multi "compare results for win/loss matrix" "" "${_jsons[@]}" || return 0
    # Headless default: feed every result to the matrix.
    [ ! -t 0 ] && [ "${#_PICKS[@]}" -eq 0 ] && _PICKS=("${_jsons[@]}")
    [ "${#_PICKS[@]}" -lt 2 ] && { echo "  picked fewer than 2 — nothing to compare"; return 0; }
    _RUN_NAME="win/loss heatmap"
    _RUN=("$T3_PYTHON" "$T3_SCRIPTS/compare_heatmap.py" "${_PICKS[@]}" --out "$T3_DIR/runs/booksim/compare_heatmap.png")
    _ui_open
}

cmd_veritx_serve() { # guided full-stack serving sim: cluster config × workload dataset
    local _lroot="$REPO_ROOT/third_party/llmservingsim"
    if [ ! -d "$_lroot" ]; then
        echo "  LLMServingSim not found at third_party/llmservingsim — 'veritx serve' needs it."
        return 0
    fi
    local _clusters=() _datasets=() _f
    for _f in "$_lroot"/configs/cluster/*.json; do
        [ -f "$_f" ] && _clusters+=("${_f#"$_lroot"/}")
    done
    for _f in "$_lroot"/workloads/*.jsonl; do
        [ -f "$_f" ] && _datasets+=("${_f#"$_lroot"/}")
    done
    if [ "${#_clusters[@]}" -eq 0 ] || [ "${#_datasets[@]}" -eq 0 ]; then
        echo "  no cluster configs or workloads found under $_lroot"
        return 0
    fi
    _ui_pick "cluster config" "${_clusters[0]}" "${_clusters[@]}" || return 0
    local _cluster="$_PICK"
    _ui_pick "workload dataset" "${_datasets[0]}" "${_datasets[@]}" || return 0
    local _dataset="$_PICK"
    _pick_num "num requests" "1" 1 2 4 8 || return 0; local _nreqs="$_PICK"
    _ui_pick "network backend" "booksim" booksim analytical ns3 || return 0
    local _backend="$_PICK"
    local _extra=()
    if _ui_pick "cycle-accurate network? (replay is ~10x faster)" "replay" replay cycle-accurate; then
        [ "$_PICK" = "cycle-accurate" ] && _extra+=(--cycle-accurate)
    fi
    _pick_num "timeout s" "600" 60 120 300 600 || return 0
    local _timeout="$_PICK"
    _ui_pick "log level" "WARNING" WARNING INFO DEBUG ERROR || return 0
    local _loglevel="$_PICK"
    if _ui_pick "keep intermediate files? (else cleaned)" "no" no yes; then
        [ "$_PICK" = "yes" ] && _extra+=(--no-cleanup)
    fi
    if _ui_pick "disable prefix caching?" "no" no yes; then
        [ "$_PICK" = "yes" ] && _extra+=(--no-prefix-caching)
    fi
    if _ui_pick "dtype (auto = serving default)" "auto" auto float16 bfloat16 float32 fp8 int8; then
        [ "$_PICK" != "auto" ] && _extra+=(--dtype "$_PICK")
    fi
    _pick_num "max seqs" "128" 32 64 128 256 512 || return 0
    _extra+=(--max-num-seqs "$_PICK")
    _pick_num "max batched tokens" "2048" 512 1024 2048 4096 8192 || return 0
    _extra+=(--max-num-batched-tokens "$_PICK")
    echo "  veritx serve --cluster-config $_cluster --dataset $_dataset --num-reqs $_nreqs --network-backend $_backend --timeout $_timeout --log-level $_loglevel"
    _confirm_run || return 0
    _RUN_NAME="veritx serve ($_backend)"
    _RUN=(_dispatch veritx legacy serve --cluster-config "$_cluster" --dataset "$_dataset" \
          --num-reqs "$_nreqs" --network-backend "$_backend" --timeout "$_timeout" \
          --log-level "$_loglevel" "${_extra[@]}")
    _ui_open
}

cmd_quick_compare() { # guided veritx compare: trace × topos, only the 3 key knobs
    _trace_list
    _ui_pick "trace" "$_TRACE_DEF" "${_traces[@]}" || return 0
    local _trace="$_PICK"
    # Size-honest topo list: preset names encode size (mesh_8x8=64,
    # mesh_4x4=16, dragonfly_72=72 — source of truth: SWEEP_TOPOS in
    # dse/veritx_dse/model/presets.py). N-suffixed CONFIGs filter to
    # their size so the walkthrough stops ranking across sizes.
    local _topo_def="mesh_8x8,torus_8x8" _topo_opts=(mesh_4x4 mesh_8x8 torus_8x8 flatfly_64 gec_express_k8 gec_mecs_k8 gec_mesh_k8 fbfly_64 cmesh_64 fattree_k4n3 qtree_64 tree4_64 dragonfly_72)
    case "${CONFIG:-}" in
        *[Nn]64) _topo_def="mesh_8x8,torus_8x8"
            _topo_opts=(mesh_8x8 torus_8x8 flatfly_64 gec_express_k8 gec_mecs_k8 gec_mesh_k8 fbfly_64 cmesh_64 fattree_k4n3 qtree_64 tree4_64) ;;
        *[Nn]16) _topo_def="mesh_4x4"
            _topo_opts=(mesh_4x4) ;;  # veritx presets are 64-centric; mesh_4x4 is the only 16-node one
    esac
    _ui_multi "topologies (space toggles, ⏎ runs)" "$_topo_def" \
        "${_topo_opts[@]}" || return 0
    [ "${#_PICKS[@]}" -eq 0 ] && return 0
    local _topos; _topos=$(IFS=,; echo "${_PICKS[*]}")
    _ui_pick "mode" "latency" latency throughput || return 0
    local _mode="$_PICK"
    _pick_num "seeds" "1" 1 2 3 5 || return 0
    local _seeds="$_PICK"
    _pick_num "timeout s/run" "120" 30 60 120 300 || return 0
    local _timeout="$_PICK"
    _pick_num "ir" "0.05" 0.01 0.02 0.05 0.1 || return 0
    local _ir="$_PICK"
    echo "  veritx compare --trace $_trace --topos $_topos --mode $_mode --seeds $_seeds --timeout $_timeout --ir $_ir --out-dir \$T3_RESULTS"
    _RUN_NAME="veritx compare (${#_PICKS[@]} topos, $_mode)"
    _RUN=(_dispatch veritx legacy compare --trace "$_trace" --topos "$_topos" \
          --mode "$_mode" --seeds "$_seeds" --timeout "$_timeout" --ir "$_ir" \
          --out-dir "$T3_RESULTS")
    _ui_open
}

