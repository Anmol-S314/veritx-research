        printf '  \033[1mStep 1/3 — sweep all topologies (~1 min; every point saves as it lands)\033[0m\n'
        _RUN_NAME="start-here: sweep"; _RUN=(_dispatch sim); _EXPLICIT=""; _ui_open
        # Step 2: quick compare (esc on any picker skips the step)
        printf '  \033[1mStep 2/3 — compare topologies on real LLM traffic\033[0m\n'
        printf '  \033[2m(⏎ keeps the suggested value; esc skips this step)\033[0m\n'
        cmd_quick_compare
        # Step 3: report + open
        printf '  \033[1mStep 3/3 — build the report and plots\033[0m\n'
        _RUN_NAME="start-here: report"; _RUN=(_dispatch report); _ui_open
        # finish OUTSIDE the alt screen so the summary stays readable
        _ui_leave
        printf '  \033[2m── start-here complete\033[0m\n\n'
        cmd_viz_open
        echo ""
        _ok "All done — you ran a full topology study. Re-run 't3 menu' anytime;"
        echo "  everything you picked is remembered for next time."
        if [ "$_IN_MENU" -eq 1 ]; then
            printf '  \033[2m⏎ back to menu\033[0m'
            IFS= read -rsn1 _kp || true
            echo ""
            _ui_enter
            _need_draw=1
        fi
        ;;
    compare*)
        cmd_quick_compare
        ;;
    just*)
        cmd_plot_config
        cmd_viz_open
        ;;
    esac
    return 0
}

