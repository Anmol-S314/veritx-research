            ;;
        cfg)
            local _c
            _opts=("CONFIG: ${CONFIG:-baseline}" \
                   "MODEL: ${MODEL:-all_reduce}" \
                   "TOPO: ${TOPO:-all}" \
                   "RATES: ${RATES:-0.002,0.005,0.01,0.02,0.03}" \
                   "workload registry: list models & collectives" \
                   "add a custom workload (guided)" \
                   "sweep logs: sessions & events" \
