cmd_energy() {
    _banner "Energy breakdown"
    # Current pipeline first: the spatial summary is a manifest written
    # atomically once, only on success — inherently fresh. The legacy
    # timeloop.stats.txt files below carry no freshness marker: a failed
    # rerun leaves the previous run's file behind and energy_report would
    # print false success from it. Hence the explicit staleness warning.
    if [ $# -eq 0 ]; then
        local _eroot="$(dirname "${T3_RESULTS:-$T3_DIR/results/baseline}")"
        local _ebase="$(basename "${T3_RESULTS:-$T3_DIR/results/baseline}")"
        if [[ "$_ebase" =~ ^(.*)(_N[0-9]+)+$ ]]; then _ebase="${BASH_REMATCH[1]}"; fi
        local _esummary="$_eroot/${_ebase}_spatial_summary.json"
        if [ -f "$_esummary" ]; then
            "$T3_PYTHON" - "$_esummary" <<'EOF'
import json, sys
rows = json.load(open(sys.argv[1]))
print(f"  {'tiles':>6} {'ops':>5} {'compute_pJ':>12} {'noc_pJ/hop':>12}")
for r in rows:
    noc = r.get("noc") or {}
    ce = r.get("compute_energy_pj", float("nan"))
    nh = noc.get("noc_energy_pj_per_hop", "n/a")
    nhs = f"{nh:>12.3g}" if isinstance(nh, (int, float)) else f"{nh:>12}"
    print(f"  {r['tiles']:>6} {r.get('real_ops', '?'):>5} {ce:>12.3g} {nhs}")
print(f"  from {sys.argv[1]} (spatial manifest — fresh by construction; "
      "noc/hop × hops_avg for system NoC energy)")
EOF
            return 0
        fi
    fi
    local stats=""
    for candidate in \
        "$T3_DIR/timeloop/timeloop-mapper.stats.txt" \
        "$T3_RESULTS/timeloop.stats.txt" \
        "$T3_DIR/results/timeloop.stats.txt" \
        "$T3_DIR/results/${CONFIG:-baseline}/timeloop.stats.txt"; do
        if [ -f "$candidate" ] && grep -q "Summary Stats" "$candidate" 2>/dev/null; then
            stats="$candidate"
            break
        fi
    done

    if [ -z "$stats" ]; then
        if [ -f "$T3_DIR/timeloop/timeloop-mapper.stats.txt" ]; then
            stats="$T3_DIR/timeloop/timeloop-mapper.stats.txt"
        else
            _warn "No Timeloop stats file with Summary Stats — run 't3 timeloop' first"
            exit 1
        fi
    fi
    echo "  ⚠ legacy stats file (no freshness marker): $stats — rerun 't3 timeloop' if stale"
    _py "$T3_SCRIPTS/energy_report.py" "$stats" "$@"
}

