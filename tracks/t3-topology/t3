_sim_set_flags() { # $1=array-name; splits $_VAL "k=v,k=v" into --set flags
    # One optional prompt covers every BookSim knob (vcs, vc-buf,
    # sample-period, max-samples, alloc_iters, …) without a prompt per knob.
    # Empty $_VAL = no-op. Forwarded --set flags win over named flags and
    # are recorded in the saved JSON (see _parse_set in cli.py).
    local -n _out="$1"
    local _kv
    [ -z "${_VAL:-}" ] && return 0
    local IFS=','
    for _kv in $_VAL; do
        _kv="${_kv//[[:space:]]/}"
        [ -n "$_kv" ] && _out+=("--set" "$_kv")
    done
}
_veritx_sub() { # subverb picker + required args, for verbs with deep flag trees
    # Usage: _veritx_sub <verb> <default-sub> <other-subs...>
    # The default sub is NOT repeated by callers — reconstruct the full choice
    # set here so the picker offers everything in declared order. (The old
    # 4-arg '_pre' design consumed sub1 as a phantom "typed sub", crashed
    # 'generate' under set -u, and reordered every picker list. No caller
    # ever passed a typed sub — deleted as dead code.)
    local _v="$1" _def="$2"; shift 2
    local _subs=("$_def" "$@")
    _ui_pick "$_v subcommand" "$_def" "${_subs[@]}" || return 0
    _sub="$_PICK"
    if [ "$_v" = "evaluate" ] && [ "$_sub" = "astra" ]; then
        echo "  [t3] evaluate/astra needs the host frontend (container libs too old)."
        echo "  Run natively: veritx evaluate astra --ets <et> --system-config <sys> --network-config <net> --memory-config <mem>"
        return 0
    fi
    if [ "$_v" = "evaluate" ] && [ "$_sub" = "anynet" ]; then
        _anynet_list
        if [ "${#_anynets[@]}" -gt 0 ]; then
            _ui_pick "anynet file (reference or synthesis winner)" "${_anynets[0]}" "${_anynets[@]}" || return 0
            local _topo="$_PICK"
            _trace_list
            _ui_pick "trace" "$_TRACE_DEF" "${_traces[@]}" || return 0
            local _args=("$_v" "$_sub" "--topo" "$_topo" "--trace" "$_PICK")
            _read_def "sim overrides, e.g. vcs=4,vc-buf=8 (empty=defaults)" "" && _sim_set_flags _args
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _args+=("--timeout" "$_PICK")
            echo "  veritx ${_args[*]}"
            _RUN_NAME="veritx $_v $_sub"
            _RUN=("_dispatch" veritx "${_args[@]}")
            _ui_open
            return 0
        fi
        echo "  no .anynet files found — falling back to manual args."
    fi
    # Required args per subcommand (pickers where possible), then the common
    # optional flags as guided prompts — same interface throughout, no raw
    # flag-typing. ⏎ accepts each default; esc skips an optional (esc on a
    # required input cancels the builder). Anything rarer: t3 exec veritx ...
    local -a _req=()
    case "$_v $_sub" in
        "trace extract")
            _trace_list
            # If the user already typed a path after 'extract', use it directly
            # instead of forcing a picker round-trip.
            local _given="${1:-}"; [ -n "$_given" ] && shift || true
            local _tr="${_given:-}"
            if [ -z "$_tr" ]; then
                _ui_pick "HPC trace file (e.g. dse/archive/inputs/traces/<job>.trace, empty=cancel)" "" "${_traces[@]}" || return 0
                _tr="$_PICK"
                [ -z "$_tr" ] && { echo "  no trace picked — cancelled."; return 0; }
            elif [ ! -f "$T3_DIR/$_tr" ] && [ ! -f "$_tr" ]; then
                echo "  trace not found: $_tr"
                return 0
            fi
            _req+=("$_tr")
            _read_def "first-N packets (e.g. 5000, empty=all)" ""
            [ -n "$_VAL" ] && _req+=("--burst" "$_VAL")
            if _ui_pick "spread uniform?" "no" no yes; then
                [ "$_PICK" = "yes" ] && _req+=("--uniform")
            fi
            _read_def "out file" "runs/traces/extract.trace" || return 0
            _req+=("--out" "$_VAL") ;;
        "trace chakra")
            # Chakra wants a FOLDER of batch traces (non-recursive *.txt
            # glob) and reads it with a plain relative Path from $T3_DIR, so
            # repo-relative display names would NOT resolve — show short names
            # but pass absolute paths (viz-gallery pattern).
            local -a _etdisp=() _etdirs=()
            local _d
            if [ -d "${REPO_ROOT}/third_party/llmservingsim/traces" ]; then
                while IFS= read -r _d; do
                    _etdisp+=("${_d#"${REPO_ROOT}"/}")
                    _etdirs+=("$_d")
                done < <(find "${REPO_ROOT}/third_party/llmservingsim/traces" \
                    -name '*.txt' -printf '%h\n' 2>/dev/null | sort -u | head -10)
            fi
            # Only offer folders that actually contain .txt batch traces.
        # A folder that holds *only* Chakra .et binaries will fail at
        # runtime without the ASTRA-sim chakra_to_et converter, so it is
        # not a usable chakra-picker pick — exclude it and explain why.
        local -a _usable=() _usable_dirs=()
        local _d _stem
        for _i in "${!_etdisp[@]}"; do
            _d="${_etdirs[_i]}"
            if [ -n "$(find "$_d" -maxdepth 1 -name '*.txt' -print -quit 2>/dev/null)" ]; then
                _usable+=("${_etdisp[_i]}")
                _usable_dirs+=("$_d")
            else
                echo "  skipped: ${_etdisp[_i]} (only .et binaries — needs ASTRA-sim chakra_to_et)"
            fi
        done
        if [ -d "$T3_DIR/dse/tests/fixtures/astra_tiny" ]; then
            _d="$T3_DIR/dse/tests/fixtures/astra_tiny"
            if [ -z "$(find "$_d" -maxdepth 1 -name '*.txt' -print -quit 2>/dev/null)" ]; then
                echo "  skipped: ${_d#"${REPO_ROOT}"/} (only .et binaries — needs ASTRA-sim chakra_to_et)"
            else
                _usable+=("${_d#"${REPO_ROOT}"/}")
                _usable_dirs+=("$_d")
            fi
        fi
        if [ "${#_usable[@]}" -gt 0 ]; then
            _ui_pick "folder with batch traces (.txt)" "${_usable[0]}" "${_usable[@]}" || return 0
            local _i
            for _i in "${!_usable[@]}"; do
                if [ "${_usable[_i]}" = "$_PICK" ]; then _req+=("${_usable_dirs[_i]}"); break; fi
            done
        else
            _read_def "trace folder (e.g. dse/tests/fixtures/astra_tiny, empty=cancel)" ""
                [ -z "$_VAL" ] && { echo "  no path given — cancelled."; return 0; }
                _req+=("$_VAL")
            fi
            local -a _npu_d=("default (4 ranks: 0,16,32,48) — skip flag"
                             "16 ranks stride-4 (0,4,…,60)"
                             "custom list…")
            local -a _npu_v=("SKIP"
                             "0,4,8,12,16,20,24,28,32,36,40,44,48,52,56,60"
                             "CUSTOM")
            if _ui_pick "npu map (which nodes act as ranks)" "${_npu_d[0]}" "${_npu_d[@]}"; then
                local _ni
                for _ni in "${!_npu_d[@]}"; do
                    if [ "${_npu_d[_ni]}" = "$_PICK" ]; then
                        case "${_npu_v[_ni]}" in
                        SKIP) ;;
                        CUSTOM)
                            _read_def "npu map — comma-separated node IDs, e.g. 0,4,8,12,16 (empty=skip)" ""
                            [ -n "$_VAL" ] && _req+=("--npu-map" "$_VAL") ;;
                        *) _req+=("--npu-map" "${_npu_v[_ni]}") ;;
                        esac
                        break
                    fi
                done
            fi
            _pick_num "nodes" "64" 4 8 16 32 64 128 && _req+=("--nodes" "$_PICK")
            _read_def "out file" "$T3_DIR/runs/traces/input.trace" && _req+=("--out" "$_VAL") ;;
        "trace model")
            _model_list
            _pick_def "traffic model" "$_MODEL_DEF" "${_models[@]}" || return 0
            _req+=("$_PICK")
            _pick_num "nodes" "64" 4 8 16 32 64 128 && _req+=("--nodes" "$_PICK")
            _read_def "out file" "$T3_DIR/runs/traces/input.trace" && _req+=("--out" "$_VAL") ;;
        "trace hpc")
            _read_def "HPC trace file (e.g. dse/archive/inputs/traces/<job>.trace, empty=cancel)" ""
            [ -z "$_VAL" ] && { echo "  no path given — cancelled."; return 0; }
            _req+=("$_VAL")
            _pick_num "nodes" "64" 4 8 16 32 64 128 && _req+=("--nodes" "$_PICK")
            _read_def "out file" "$T3_DIR/runs/traces/input.trace" && _req+=("--out" "$_VAL") ;;
        "trace slice")
            _trace_list
            local _given="${1:-}"; [ -n "$_given" ] && shift || true
            local _tr="${_given:-}"
            if [ -z "$_tr" ]; then
                _ui_pick "HPC trace file (e.g. dse/archive/inputs/traces/<job>.trace, empty=cancel)" "" "${_traces[@]}" || return 0
                _tr="$_PICK"
                [ -z "$_tr" ] && { echo "  no trace picked — cancelled."; return 0; }
            elif [ ! -f "$T3_DIR/$_tr" ] && [ ! -f "$_tr" ]; then
                echo "  trace not found: $_tr"
                return 0
            fi
            # args AFTER the sub: the tail builds ("$_v" "$_sub" ...) once.
            _req+=("--trace" "$_tr")
            _read_def "classes (comma-separated ints)" "0"
            _req+=("--classes" "$_VAL" "--out" "${_tr%.trace}_slice.trace")
            if _ui_pick "renumber classes?" "no" no yes; then
                [ "$_PICK" = "yes" ] && _req+=("--renumber")
            fi ;;
        "trace info"|"trace validate")
            _trace_list
            # Direct-type path: user typed the file after the subcommand.
            local _given="${1:-}"; [ -n "$_given" ] && shift || true
            local _tr="${_given:-}"
            if [ -z "$_tr" ]; then
                _ui_pick "HPC trace file (e.g. dse/archive/inputs/traces/<job>.trace, empty=cancel)" "" "${_traces[@]}" || return 0
                _tr="$_PICK"
                [ -z "$_tr" ] && { echo "  no trace picked — cancelled."; return 0; }
            elif [ ! -f "$T3_DIR/$_tr" ] && [ ! -f "$_tr" ]; then
                echo "  trace not found: $_tr"
                return 0
            fi
            _req+=("$_tr") ;;
        "synthesize bo")
            _trace_list
            _ui_pick "traffic trace" "$_TRACE_DEF" "${_traces[@]}" || return 0
            _req+=("--traffic" "$_PICK")
            _pick_num "nodes" "64" 4 8 16 32 64 128 && _req+=("--nodes" "$_PICK")
            _pick_num "iterations" "50" 1 2 3 5 10 25 50 100 && _req+=("--iters" "$_PICK")
            if _ui_pick "scorer (cost model)" "analytical" analytical booksim; then
                _req+=("--scorer" "$_PICK")
            fi
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "synthesize iterative")
            _trace_list
            _ui_pick "traffic trace" "$_TRACE_DEF" "${_traces[@]}" || return 0
            _req+=("--trace" "$_PICK")
            if _ui_pick "method" "rho" rho grpo; then
                _req+=("--method" "$_PICK")
            fi
            _pick_num "steps" "50" 1 2 3 5 10 25 50 100 && _req+=("--steps" "$_PICK")
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "evaluate booksim")
            _trace_list
            _ui_pick "trace file" "$_TRACE_DEF" "${_traces[@]}" || return 0
            _req+=("--trace" "$_PICK")
            _ui_pick "topology (preset)" "mesh_8x8" mesh_4x4 mesh_8x8 torus_8x8 flatfly_64 gec_express_k8 gec_mecs_k8 gec_mesh_k8 fbfly_64 cmesh_64 fattree_k4n3 qtree_64 tree4_64 dragonfly_72 || return 0
            _req+=("--topo" "$_PICK")
            _read_def "sim overrides, e.g. vcs=4,vc-buf=8 (empty=defaults)" "" && _sim_set_flags _req
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "certify flow")
            _model_list
            _pick_def "traffic model" "$_MODEL_DEF" "${_models[@]}" || return 0
            local _mdl="$_PICK"
            _anynet_list
            if [ "${#_anynets[@]}" -gt 0 ]; then
                _ui_pick "topology (.anynet reference/winner)" "${_anynets[0]}" "${_anynets[@]}" || return 0
                local _topo="$_PICK"
            else
                _read_def "topology (.anynet path, e.g. dse/runs/booksim/topo.anynet, empty=cancel)" ""
                local _topo="$_VAL"
            fi
            [ -z "$_topo" ] && { echo "  no topology given — cancelled."; return 0; }
            _req+=("--model" "$_mdl" "--topo" "$_topo")
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "certify rtl")
            _anynet_list
            if [ "${#_anynets[@]}" -gt 0 ]; then
                _ui_pick "topology (.anynet reference/winner)" "${_anynets[0]}" "${_anynets[@]}" || return 0
                local _topo="$_PICK"
            else
                _read_def "topology (.anynet path, e.g. dse/runs/booksim/topo.anynet, empty=cancel)" ""
                local _topo="$_VAL"
            fi
            [ -z "$_topo" ] && { echo "  no topology given — cancelled."; return 0; }
            # obj_dir-bearing build dirs only — veritx certify rtl fails fast
            # without one ("no obj_dir in ...").
            local -a _builddirs=()
            local _bd
            for _bd in "$T3_DIR"/scripts/rtlgen/*/; do
                [ -d "$_bd/obj_dir" ] && _builddirs+=("${_bd#"$T3_DIR"/}")
            done
            if [ "${#_builddirs[@]}" -gt 0 ]; then
                _ui_pick "rtl build dir (with obj_dir/)" "${_builddirs[0]}" "${_builddirs[@]}" || return 0
                _req+=("--topo" "$_topo" "--build-dir" "$_PICK")
            else
                _req+=("--topo" "$_topo")
            fi
            if _ui_pick "tier" "quick" quick full; then
                _req+=("--tier" "$_PICK")
            fi
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "certify full")
            _model_list
            _pick_def "traffic model" "$_MODEL_DEF" "${_models[@]}" || return 0
            local _mdl="$_PICK"
            _anynet_list
            if [ "${#_anynets[@]}" -gt 0 ]; then
                _ui_pick "topology (.anynet reference/winner)" "${_anynets[0]}" "${_anynets[@]}" || return 0
                local _topo="$_PICK"
            else
                _read_def "topology (.anynet path, e.g. dse/runs/booksim/topo.anynet, empty=cancel)" ""
                local _topo="$_VAL"
            fi
            [ -z "$_topo" ] && { echo "  no topology given — cancelled."; return 0; }
            _req+=("--model" "$_mdl" "--topo" "$_topo")
            if _ui_pick "tier" "quick" quick full; then
                _req+=("--tier" "$_PICK")
            fi
            _pick_num "timeout s (esc = default)" "300" 30 60 120 300 600 && _req+=("--timeout" "$_PICK") ;;
        "generate uvm")
            local -a _reqs=()
            local _rf
            for _rf in "$T3_DIR"/dse/examples/*.json "$T3_DIR"/runs/compile_requests/*.json; do
                [ -f "$_rf" ] || continue
                _reqs+=("${_rf#"$T3_DIR"/}")
            done
            local _rdef="dse/examples/moe_8npu.json"
            [[ " ${_reqs[*]} " != *" $_rdef "* ]] && _reqs=("$_rdef" "${_reqs[@]}")
            _ui_pick "CompileRequest" "$_rdef" "${_reqs[@]}" || return 0
            _req+=("--request" "$_PICK")
            _read_def "out dir" "runs/uvm" && _req+=("--out" "$_VAL")
            _pick_num "nodes" "64" 4 8 16 32 64 128 && _req+=("--nodes" "$_PICK") ;;        esac
        # args AFTER the sub — the tail prepends ("$_v" "$_sub") exactly once.
        # (Old per-branch '$_sub' prefixes built malformed 'veritx trace slice
        # slice …' commands; now every branch stores post-sub args only.)
        local _args=("$_v" "$_sub" "${_req[@]}")
    echo "  veritx ${_args[*]}"
    _RUN_NAME="veritx $_v $_sub"
    _RUN=(_dispatch veritx "${_args[@]}")
    _ui_open
}

cmd_veritx_compare() { # interactive compare builder: every flag behind a picker
    _trace_list
    _ui_pick "trace" "$_TRACE_DEF" "${_traces[@]}" || return 0
    local _trace="$_PICK"
    _ui_multi "topologies (space toggle, enter runs)" "mesh_8x8,torus_8x8" \
        mesh_4x4 mesh_8x8 torus_8x8 flatfly_64 gec_express_k8 gec_mecs_k8 gec_mesh_k8 fbfly_64 cmesh_64 fattree_k4n3 qtree_64 tree4_64 dragonfly_72 || return 0
    [ "${#_PICKS[@]}" -eq 0 ] && { echo "  pick at least one topology."; return 0; }
    local _topos
    _topos=$(IFS=,; echo "${_PICKS[*]}")
    _anynet_list
    _ui_multi "anynet files: refs (archive/inputs, rtlgen) + synthesis winners (runs/booksim)" "" "${_anynets[@]}" || return 0
    local _anynet
    _anynet=$(IFS=,; echo "${_PICKS[*]}")
    _ui_pick "mode" "latency" latency throughput || return 0
    local _mode="$_PICK"
    _pick_num "seeds" "1" 1 2 3 5 || return 0
    local _seeds="$_PICK"
    _pick_num "seed-base (0=auto)" "0" 0 1 42 || return 0
    local _seedbase="$_PICK"
    _pick_num "timeout s/run" "120" 30 60 120 300 || return 0
    local _timeout="$_PICK"
    _pick_num "ir" "0.05" 0.01 0.02 0.05 0.1 || return 0
    local _ir="$_PICK"
    # MEMORY-ROADMAP §2 quarantine: the compare --memory scalar correction
    # is deprecated and refused fail-closed by the CLI (it was
    # topology-invariant, measured +0.0c). No toggle offered here; memory
    # modelling returns via an explicit backend, not these flags.
    local _dense="none"
    if _ui_pick "dense preset (extra baselines; none skips)" "none" none llama70b_ring llama70b_a2a qwen3_moe; then _dense="$_PICK"; fi
    # Dense presets bundle topos + .anynet files from synthesis runs. Expand
    # the pick inline (what it adds, which files exist) instead of a blind
    # name — and if its files were never generated, fall back to the picked
    # topologies rather than letting the CLI abort the whole compare.
    if [ "$_dense" != "none" ]; then
        local _dblob _ddesc _dtopos _dfiles _df _dmissing=()
        _dblob=$(PYTHONPATH="$T3_DIR/dse${PYTHONPATH:+:$PYTHONPATH}" "$T3_PYTHON" -c \
            "from veritx_dse.model.presets import DENSE_PRESETS
p = DENSE_PRESETS.get('$_dense', {})
print(p.get('desc', ''))
print(p.get('topos', ''))
print(' '.join(p.get('anynet', [])))" 2>/dev/null)
        { IFS= read -r _ddesc; IFS= read -r _dtopos; IFS= read -r _dfiles; } <<< "$_dblob"
        echo "  dense '$_dense': $_ddesc"
        [ -n "$_dtopos" ] && echo "    + topos: $_dtopos"
        for _df in $_dfiles; do
            if [ -f "${REPO_ROOT}/${_df}" ]; then
                echo "    + file ✓ $_df"
            else
                echo "    + file ✗ $_df (missing)"
                _dmissing+=("$_df")
            fi
        done
        [ -z "$_dfiles" ] && echo "    + files: none bundled"
        if [ "${#_dmissing[@]}" -gt 0 ]; then
            _warn "dense preset '$_dense' needs files that were never generated: ${_dmissing[*]}"
            echo "  make them with: veritx synthesize bo (or pick none). Continuing with picked topologies."
            _dense="none"
        fi
    fi
    _ui_multi "sensitivity IRs (space toggle, empty=skip)" "" 0.01 0.02 0.05 0.1 || true
    local _sens="${_PICKS[*]}"
    local _args=(compare --trace "$_trace" --topos "$_topos" --seeds "$_seeds" --seed-base "$_seedbase" --mode "$_mode" --timeout "$_timeout" --ir "$_ir")
    [ -n "$_anynet" ] && [ "$_anynet" != "none" ] && _args+=(--anynet "$_anynet")
    [ "$_dense" != "none" ] && _args+=(--dense "$_dense")
    # shellcheck disable=SC2086
    [ -n "$_sens" ] && _args+=(--sensitivity $_sens)
    echo "  veritx ${_args[*]}"
    _RUN_NAME="veritx compare ($_topos)"
    _RUN=(_dispatch veritx "${_args[@]}")
    _ui_open
}

cmd_clean() {
    _banner "Clean"
    local _force=0 _a
    for _a in "$@"; do [ "$_a" = "--force" ] && _force=1; done
    if [ $_force -eq 0 ]; then
        if [ ! -t 0 ]; then
            echo "  refusing: 't3 clean' deletes results/. Confirm headless with: t3 clean --force"
            return 1
        fi
        _ui_pick "clean - permanently delete results/ ?" "no" \
            "no" "yes, delete results/" || return 0
        case "$_PICK" in yes*) ;; *) echo "  kept."; return 0;; esac
    fi
    rm -rf "$T3_DIR/results" $T3_DIR/timeloop/timeloop-mapper* "$T3_DIR/__pycache__" "$T3_SCRIPTS/__pycache__"
    # Dashboard + root cross-track report outputs are generated artifacts too:
    # a clean that leaves them makes the next 'report/dashboard' look stale-but-current.
    rm -rf "$T3_DIR/report" "$REPO_ROOT/report"
    _ok "Removed results/, timeloop-mapper artifacts, report/, and __pycache__"
}

cmd_exec() {
    "$@"
}

# ── modelling infrastructure: registry-backed custom workloads ────────────
cmd_model() { # list the workload registry (models + collectives)
    "$T3_PYTHON" "$T3_SCRIPTS/lib/t3models.py" list
}
cmd_model_add() { # guided: clone or define a workload; lands in workloads/<name>.json
    echo "  ── new workload → workloads/<name>.json (picked up by every MODEL picker) ──"
    # Headless (non-TTY, e.g. webui/scripts): everything from env/args.
    #   MODEL_NAME=<name> [MODEL_BASE=llama7b|all_reduce|…] [MODEL_DISPLAY=…]
    #   [MODEL_MSG_MB=…] [MODEL_HIDDEN=…] [MODEL_FFN=…] [MODEL_LAYERS=…]
    #   [MODEL_SEQ=…] [MODEL_BATCH=…] [MODEL_TP=…] [MODEL_PP=…]
    if [ ! -t 0 ]; then
        local _name="${1:-${MODEL_NAME:-}}" _extra=()
        [ -z "$_name" ] && { echo "  ✗ headless usage: MODEL_NAME=<name> [MODEL_BASE=…] [MODEL_LAYERS=4 …] t3 model-add"; return 1; }
        # set -e-safe: an unset var must not return 1 from the function
        _env_flag() { if [ -n "${!1:-}" ]; then _extra+=("$2" "${!1}"); fi; return 0; }
        _env_flag MODEL_MSG_MB --msg-mb;  _env_flag MODEL_HIDDEN --hidden
        _env_flag MODEL_FFN    --ffn;     _env_flag MODEL_LAYERS --layers
        _env_flag MODEL_SEQ    --seq;     _env_flag MODEL_BATCH  --batch
        _env_flag MODEL_TP     --tp;      _env_flag MODEL_PP     --pp
        if "$T3_PYTHON" "$T3_SCRIPTS/lib/t3models.py" add "$_name" \
            --base "${MODEL_BASE:-llama7b}" --display "${MODEL_DISPLAY:-$_name}" \
            "${_extra[@]}"; then
            _ok "saved workloads/$_name.json"; echo "  run it:  MODEL=$_name t3 astrasim"
            return 0
        fi
        echo "  ✗ could not save (name clash with a built-in? bad value?)"; return 1
    fi
    _ui_pick "base (clone defaults from)" "llama7b" llama7b llama13b llama70b gpt3 resnet50 all_reduce all_to_all reduce_scatter all_gather none || return 0
    local _base="$_PICK"
    _read_def "name (lowercase [a-z0-9_], e.g. mymodel7b, empty=cancel)" "" ; local _name="$_VAL"
    [ -z "$_name" ] && { echo "  ✗ name required"; return 1; }
    _read_def "display name (empty=keeps name)" "$_name"; local _dname="$_VAL"
    local _extra=()
    if [ "$_base" = "all_reduce" ] || [ "$_base" = "all_to_all" ] || \
       [ "$_base" = "reduce_scatter" ] || [ "$_base" = "all_gather" ]; then
        _pick_num "message size MB" "16" 1 4 16 64 256 || return 0; _extra+=(--kind collective --msg-mb "$_PICK")
    elif [ "$_base" = "none" ]; then
        # From scratch: no base to inherit from, so every knob is required.
        _read_def "num_layers (e.g. 32)" ""; [ -z "$_VAL" ] && { echo "  ✗ num_layers required"; return 1; }; _extra+=(--layers "$_VAL")
        _read_def "hidden_size (e.g. 4096)" ""; [ -z "$_VAL" ] && { echo "  ✗ hidden_size required"; return 1; }; _extra+=(--hidden "$_VAL")
        _read_def "ffn_size (e.g. 11008)" ""; [ -z "$_VAL" ] && { echo "  ✗ ffn_size required"; return 1; }; _extra+=(--ffn "$_VAL")
        _read_def "seq_len (e.g. 2048)" ""; [ -z "$_VAL" ] && { echo "  ✗ seq_len required"; return 1; }; _extra+=(--seq "$_VAL")
        _read_def "batch_size (e.g. 2)" ""; [ -z "$_VAL" ] && { echo "  ✗ batch_size required"; return 1; }; _extra+=(--batch "$_VAL")
        _read_def "tp_degree (e.g. 4)" ""; [ -z "$_VAL" ] && { echo "  ✗ tp_degree required"; return 1; }; _extra+=(--tp "$_VAL")
        _read_def "pp_degree (e.g. 4)" ""; [ -z "$_VAL" ] && { echo "  ✗ pp_degree required"; return 1; }; _extra+=(--pp "$_VAL")
    elif [ "$_base" != "none" ]; then
        # Defaults come from the base model itself (⏎ keeps each one) —
        # no blind typing, no "keep base" ambiguity.
        local _bjson _bget='import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))'
        _bjson=$("$T3_PYTHON" "$T3_SCRIPTS/lib/t3models.py" show "$_base" 2>/dev/null) || _bjson="{}"
        local _bl _bh _bf _bs _bb _bt _bp
        _bl=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" num_layers)
        _bh=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" hidden_size)
        _bf=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" ffn_size)
        _bs=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" seq_len)
        _bb=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" batch_size)
        _bt=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" tp_degree)
        _bp=$(echo "$_bjson" | "$T3_PYTHON" -c "$_bget" pp_degree)
        # num_layers first: the knob people actually override.
        _read_def "num_layers [base ${_bl:-?}]" "$_bl"; [ -n "$_VAL" ] && _extra+=(--layers "$_VAL")
        _read_def "hidden_size [base ${_bh:-?}]" "$_bh"; [ -n "$_VAL" ] && _extra+=(--hidden "$_VAL")
        _read_def "ffn_size [base ${_bf:-?}]" "$_bf"; [ -n "$_VAL" ] && _extra+=(--ffn "$_VAL")
        _read_def "seq_len [base ${_bs:-?}]" "$_bs"; [ -n "$_VAL" ] && _extra+=(--seq "$_VAL")
        _read_def "batch_size [base ${_bb:-?}]" "$_bb"; [ -n "$_VAL" ] && _extra+=(--batch "$_VAL")
        _read_def "tp_degree [base ${_bt:-?}]" "$_bt"; [ -n "$_VAL" ] && _extra+=(--tp "$_VAL")
        _read_def "pp_degree [base ${_bp:-?}]" "$_bp"; [ -n "$_VAL" ] && _extra+=(--pp "$_VAL")
    fi
    if "$T3_PYTHON" "$T3_SCRIPTS/lib/t3models.py" add "$_name" --base "$_base" \
        --display "$_dname" "${_extra[@]}"; then
        _ok "saved workloads/$_name.json"
        echo "  run it:  MODEL=$_name t3 astrasim"
        export MODEL="$_name"; _state_set
    else
        echo "  ✗ could not save (name clash with a built-in? bad value?)"
        return 1
    fi
}

