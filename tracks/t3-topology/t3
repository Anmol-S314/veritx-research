cmd_astrasim() {
    _banner "ASTRA-Sim 2.0 Workload Pipeline"
    # The frontend is host-built (new glibc/protobuf); in-container it can't
    # load. Fail fast with the working command instead of rc=127 runs that
    # also clobber results/ with failure rows.
    if [ "${IN_CONTAINER:-0}" -eq 1 ] && command -v ldd >/dev/null 2>&1; then
        _asim="${ASTRASIM_BIN:-$REPO_ROOT/third_party/astra-sim/astra-sim/network_frontend/booksim2/bin/AstraSim_BookSim2}"
        if ! [ -x "$_asim" ] || ldd "$_asim" 2>/dev/null | grep -q "not found"; then
            echo "  [t3] astrasim frontend can't load in this container (old libs)."
            echo "  Run natively from a host terminal instead (from your checkout):"
            echo "    cd tracks/t3-topology"
            echo -n "    "
            [ -n "${MODEL:-}" ] && echo -n "MODEL=$MODEL "
            [ -n "${TOPO:-}" ] && echo -n "TOPO=$TOPO "
            echo "./t3 astrasim --config ${CONFIG:-baseline}"
            return 1
        fi
    fi
    local _extra=""
    [ -n "${MODEL:-}" ] && _extra="--model $MODEL"
    [ -n "${TOPO:-}" ] && _extra="$_extra --topo $TOPO"
    [ -n "${SIZES:-}" ] && [ "$SIZES" != "auto" ] && _extra="$_extra --sizes $SIZES"
    # Workload-size overrides (same MODEL_* env model-add accepts; explicit
    # "$@" flags win by argparse last-wins). Env-only, no picker prompts —
    # e.g. MODEL_TP=8 t3 astrasim. Never persisted (see _state_set).
    local _ov _oe
    for _ov in HIDDEN:hidden-size FFN:ffn-size LAYERS:num-layers SEQ:seq-len BATCH:batch-size TP:tp PP:pp; do
        _oe="MODEL_${_ov%%:*}"
        [ -n "${!_oe:-}" ] && _extra="$_extra --${_ov#*:} ${!_oe}"
    done
    # Phase 3a: MODEL/TOPO/CONFIG env are defaults; explicit "$@" flags are
    # forwarded last so they win (argparse last-wins). Previously "$@" was
    # dropped entirely and the command was rebuilt from env only.
    # shellcheck disable=SC2086
    # PYTHONPATH: native sentinel re-entry runs cmd_astrasim OUTSIDE the
    # container, where nothing else puts dse/ on sys.path (the container's
    # run/env.sh used to be the only place this was set).
    ( cd "$T3_DIR" && PYTHONPATH="$T3_DIR/dse${PYTHONPATH:+:$PYTHONPATH}" \
        python3 scripts/run_astrasim.py \
        --config "${CONFIG:-baseline}" $_extra "$@" )
}

cmd_timeloop_workload() { # workload spine: registry model -> Chakra ET -> BookSim sweep
    # Runs fully in-container: the ET generator is pure Python and the sim is
