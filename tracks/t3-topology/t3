                   "overlay" "bars" "heat" "menu_run:dashboard" "open_png" \
                   "menu_run:model" "page:main")
            ;;
        veritx)
            _opts=("where: resolve asset by short name" \
                   "compare: full compare builder" \
                   "compile: pick a CompileRequest" \
                   "sweep: batch-evaluate topologies" \
                   "pareto: multi-workload Pareto" \
                   "baseline: published baselines" \
                   "run: full pipeline trace→synth→eval→cert" \
                   "service list: verified Wave-C results" \
                   "serve: full-stack LLM serving sim (guided)" \
