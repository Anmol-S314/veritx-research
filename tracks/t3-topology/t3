#!/usr/bin/env bash
# =============================================================================
# t3  —  top-level CLI for the T3 Topology track
#
# Usage (from ANY directory):
#   t3 <command> [options]
#
# Quick start:
#   source /path/to/tracks/t3-topology/run/env.sh  # sets up env once per shell
#   t3 help                                          # list all commands
#   t3 analysis                                      # run PA-01 summary
#   t3 aggregate                                     # run PA-02, write aggregate.csv
#   t3 plot                                          # run PA-03, write latency_curves.png
#   t3 all                                           # run analysis → aggregate → plot
# =============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# Resolve T3_DIR (the directory that contains this script)
# ---------------------------------------------------------------------------
T3_SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
T3_DIR="$(cd "$(dirname "$T3_SCRIPT_PATH")" && pwd)"

# Source run/env.sh — the canonical location for the T3 environment bootstrap
# shellcheck source=run/env.sh
_T3_ENV="$T3_DIR/run/env.sh"
if [ -f "$_T3_ENV" ]; then
    source "$_T3_ENV" 2>/dev/null || {
        echo "  [t3] ERROR: cannot source $_T3_ENV" >&2
        exit 1
    }
else
    echo "  [t3] ERROR: env.sh not found at $_T3_ENV" >&2
    echo "  [t3]   Expected location: tracks/t3-topology/run/env.sh" >&2
    exit 1
fi
unset _T3_ENV

# Redirect to a default output dir if not set (results/<config>/analysis/)
T3_OUTPUT="${T3_OUTPUT:-$T3_RESULTS/analysis}"
mkdir -p "$T3_OUTPUT"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_py() {
    # Run a python script with the resolved python, forwarding all extra args
    "$T3_PYTHON" "$@"
}

_banner() {
    echo ""
    echo "  ╔══════════════════════════════════╗"
    printf  "  ║  %-32s  ║\n" "$1"
    echo "  ╚══════════════════════════════════╝"
    echo ""
}

_ok()   { echo "  ✓  $*"; }
_warn() { echo "  ⚠  $*"; }
_err()  { echo "  ✗  $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_help() {
    cat <<'EOF'

  t3 — T3 Topology Track CLI
  ══════════════════════════════════════════════════════════════════

  Usage:  t3 <command> [options]

  SETUP
    help          Show this message
    env           Print all active environment variables
    check         Verify Python, Booksim, pandas, matplotlib are available

  ANALYSIS  (PA-01 / PA-02 / PA-03)
    analysis      Load sweep JSON → DataFrame summary (PA-01)
    aggregate     Merge all results → results/<config>/analysis/aggregate.csv (PA-02)
    plot          Latency-throughput curves → results/<config>/analysis/latency_curves.png (PA-03)
    all           Run analysis → aggregate → plot in sequence

  SIMULATION
    sim           Uniform-traffic Booksim sweep (baseline)
    timeloop      Full spine: Timeloop → matrix → topology sweep

  REPORTING
    dashboard     Build report/t3/index.html (Plotly dashboard)
    energy        Timeloop energy breakdown → results/<config>/energy.json

  DEVELOPMENT
    selfcheck     Run --selfcheck on analysis, aggregate, plot_curves
    lint          Syntax-check all Python scripts
    clean         Remove results/ and __pycache__

  ══════════════════════════════════════════════════════════════════

  ENVIRONMENT VARIABLES (set before 'source env.sh' to override defaults)

    BOOKSIM_BIN        path to booksim binary   [default: booksim (on PATH)]
    RATES              comma-separated sweep rates  [default: 0.002,0.005,0.01,0.02,0.03]
    TRAFFIC_MATRIX     path to traffic matrix file  [default: unset → uniform traffic]
    PACKET_SIZE_BITS   energy proxy constant    [default: 128]
    SAT_K              saturation multiplier    [default: 2.0]
    MPLBACKEND         matplotlib backend       [default: Agg]
    T3_OUTPUT          writable analysis dir    [default: results/<config>/analysis/]
    T3_RESULTS         results directory        [default: results/<config>/]

  EXAMPLES

    # Standard entry point — run from the 'run' directory:
    cd tracks/t3-topology/run
    source env.sh && t3 all

    # From anywhere:
    source ~/Research/veritx-research/tracks/t3-topology/run/env.sh
    t3 plot --hops

    # Override output dir and run simulation:
    T3_OUTPUT=/data/my_run source env.sh && t3 sim

    # Override rates:
    RATES="0.01,0.02,0.03,0.05" t3 sim

EOF
}

cmd_env() {
    _banner "T3 Active Environment"
    echo "  T3_DIR          = $T3_DIR"
    echo "  REPO_ROOT       = $REPO_ROOT"
    echo "  T3_PYTHON       = $T3_PYTHON"
    echo "  BOOKSIM_BIN     = $BOOKSIM_BIN"
    echo "  T3_SCRIPTS      = $T3_SCRIPTS"
    echo "  T3_RESULTS      = $T3_RESULTS"
    echo "  T3_OUTPUT       = $T3_OUTPUT"
    echo "  PACKET_SIZE_BITS= $PACKET_SIZE_BITS"
    echo "  SAT_K           = $SAT_K"
    echo "  RATES           = $RATES"
    echo "  TRAFFIC_MATRIX  = ${TRAFFIC_MATRIX:-<unset>}"
    echo "  MPLBACKEND      = $MPLBACKEND"
    echo ""
}

cmd_check() {
    _banner "Environment Check"
    # Python
    if [ -x "$T3_PYTHON" ]; then
        _ok "python3     → $T3_PYTHON  ($("$T3_PYTHON" --version 2>&1))"
    else
        _err "python3 not found (expected at $T3_PYTHON)"
    fi
    # pandas
    "$T3_PYTHON" -c "import pandas" 2>/dev/null \
        && _ok "pandas      → $("$T3_PYTHON" -c "import pandas; print(pandas.__version__)")" \
        || _warn "pandas not installed  (run: $T3_PYTHON -m pip install pandas matplotlib)"
    # matplotlib
    "$T3_PYTHON" -c "import matplotlib" 2>/dev/null \
        && _ok "matplotlib  → $("$T3_PYTHON" -c "import matplotlib; print(matplotlib.__version__)")" \
        || _warn "matplotlib not installed"
    # booksim
    command -v "$BOOKSIM_BIN" &>/dev/null \
        && _ok "booksim     → $(command -v "$BOOKSIM_BIN")" \
        || _warn "booksim not on PATH  (set BOOKSIM_BIN=/path/to/booksim)"
    # sweep JSON
    [ -f "$T3_RESULTS/topology_sweep.json" ] \
        && _ok "sweep JSON  → $T3_RESULTS/topology_sweep.json" \
        || _warn "No sweep JSON yet  (run: t3 sim)"
    echo ""
}

cmd_analysis() {
    _banner "PA-01  analysis.py"
    _py "$T3_SCRIPTS/analysis.py" "$@"
}

cmd_aggregate() {
    _banner "PA-02  aggregate.py"
    local out="${T3_OUTPUT}/aggregate.csv"
    _py "$T3_SCRIPTS/aggregate.py" \
        --results "$T3_RESULTS" \
        --out "$out" "$@"
    _ok "Written → $out"
}

cmd_plot() {
    _banner "PA-03  plot_curves.py"
    local out="${T3_OUTPUT}/latency_curves.png"
    # Allow caller to pass --out and other flags through
    _py "$T3_SCRIPTS/plot_curves.py" \
        --sweep "$T3_RESULTS/topology_sweep.json" \
        --k "$SAT_K" \
        "$@" \
        --out "${out}"
    _ok "Written → $out"
}

cmd_all() {
    _banner "Running full analysis pipeline"
    cmd_analysis
    cmd_aggregate
    cmd_plot --hops
    _ok "Pipeline complete. Outputs in $T3_OUTPUT/"
}

cmd_sim() {
    _banner "Booksim uniform sweep"
    ( cd "$T3_DIR" && RATES="$RATES" _py "$T3_SCRIPTS/run_experiments.py" "$@" )
}

cmd_timeloop() {
    _banner "Full spine: Timeloop → matrix → sweep"
    ( cd "$T3_DIR" && make timeloop )
}

cmd_dashboard() {
    _banner "Building dashboard"
    ( cd "$T3_DIR" && _py "$T3_SCRIPTS/generate_dashboard.py" "$@" )
}

cmd_energy() {
    _banner "Energy breakdown"
    local stats=""
    for candidate in \
        "$T3_RESULTS/timeloop.stats.txt" \
        "$T3_DIR/results/timeloop.stats.txt" \
        "$T3_DIR/results/${CONFIG:-baseline}/timeloop.stats.txt" \
        "$T3_DIR/timeloop/timeloop-mapper.stats.txt"; do
        if [ -f "$candidate" ]; then
            stats="$candidate"
            break
        fi
    done

    if [ -z "$stats" ]; then
        _warn "No timeloop.stats.txt — run 't3 timeloop' first"
        exit 1
    fi
    _py "$T3_SCRIPTS/energy_report.py" "$stats"
}

cmd_selfcheck() {
    _banner "Selfcheck — all PA scripts"
    _py "$T3_SCRIPTS/analysis.py"   --selfcheck && _ok "analysis.py   OK"
    _py "$T3_SCRIPTS/aggregate.py"  --selfcheck && _ok "aggregate.py  OK"
    _py "$T3_SCRIPTS/plot_curves.py" --selfcheck && _ok "plot_curves.py OK"
}

cmd_lint() {
    _banner "Lint — syntax check"
    for f in "$T3_SCRIPTS"/*.py; do
        "$T3_PYTHON" -m py_compile "$f" && _ok "$(basename "$f")" || _warn "$(basename "$f") has errors"
    done
}

cmd_clean() {
    _banner "Clean"
    rm -rf "$T3_OUTPUT" "$T3_DIR/__pycache__" "$T3_SCRIPTS/__pycache__"
    _ok "Removed output/ and __pycache__"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
COMMAND="${1:-help}"
shift || true   # pop first arg; remaining $@ forwarded to sub-commands

case "$COMMAND" in
    help|-h|--help)   cmd_help        ;;
    env)              cmd_env         ;;
    check)            cmd_check       ;;
    analysis)         cmd_analysis "$@" ;;
    aggregate)        cmd_aggregate "$@" ;;
    plot)             cmd_plot "$@"   ;;
    all)              cmd_all         ;;
    sim)              cmd_sim "$@"    ;;
    timeloop)         cmd_timeloop    ;;
    dashboard)        cmd_dashboard "$@" ;;
    energy)           cmd_energy      ;;
    selfcheck)        cmd_selfcheck   ;;
    lint)             cmd_lint        ;;
    clean)            cmd_clean       ;;
    *)
        echo "  [t3] Unknown command: '$COMMAND'"
        echo "  Run 't3 help' for usage."
        exit 1
        ;;
esac
