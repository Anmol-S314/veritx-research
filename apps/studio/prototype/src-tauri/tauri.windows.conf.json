{
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/gateway": "gateway"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
