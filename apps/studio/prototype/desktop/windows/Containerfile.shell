# Official Tauri Linux -> Windows MSVC/NSIS tool route. Build tools only;
# accepts neither application source nor user credentials.
FROM localhost/srota-windows-tools:acceptance
USER root
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    clang lld llvm nsis pkg-config libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*
USER builder
ENV CARGO_HOME=/home/builder/.cargo RUSTUP_HOME=/home/builder/.rustup
ENV PATH=/home/builder/.cargo/bin:$PATH
RUN curl --fail --location --retry 2 https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain stable \
    && rm /tmp/rustup.sh
RUN rustup target add x86_64-pc-windows-msvc \
    && cargo install --locked cargo-xwin tauri-cli \
    && cargo xwin --version && cargo tauri --version && makensis -VERSION
